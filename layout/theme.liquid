    <script>
document.addEventListener('DOMContentLoaded', function() {
  const menuButton = document.querySelector('.header__icon--menu');
  const headerWrapper = document.querySelector('.header-wrapper');
  
  if (menuButton && headerWrapper) {
    // Create a MutationObserver to watch for aria-expanded changes
    const observer = new MutationObserver(function(mutations) {
      mutations.forEach(function(mutation) {
        if (mutation.type === 'attributes' && mutation.attributeName === 'aria-expanded') {
          const isExpanded = menuButton.getAttribute('aria-expanded') === 'true';
          
          if (isExpanded) {
            headerWrapper.style.background = 'white';
            headerWrapper.style.setProperty('background', 'white', 'important');
          } else {
            headerWrapper.style.background = '';
          }
        }
      });
    });
    
    // Start observing the summary element for attribute changes
    observer.observe(menuButton, {
      attributes: true,
      attributeFilter: ['aria-expanded']
    });
  }
});
</script>
