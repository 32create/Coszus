  // Keep Product Details tab always open - Enhanced Version
(function() {
  'use strict';
  
  function forceTabOpen() {
    console.log('Attempting to open Product Details tab...');
    
    // Find all FAQ containers
    const faqContainers = document.querySelectorAll('.faq-template--26305602126208__ss_tabs_block_y3Khgx');
    
    console.log('Found FAQ containers:', faqContainers.length);
    
    faqContainers.forEach((container, index) => {
      // Check if this is the Product Details tab
      const buttonDiv = container.querySelector('.button-template--26305602126208__ss_tabs_block_y3Khgx');
      const answerDiv = container.querySelector('.answer-template--26305602126208__ss_tabs_block_y3Khgx');
      const arrowIcon = container.querySelector('.icon-template--26305602126208__ss_tabs_block_y3Khgx');
      
      if (buttonDiv && answerDiv && arrowIcon) {
        const buttonText = buttonDiv.textContent.trim();
        console.log('Tab ' + index + ' text:', buttonText);
        
        // Check if this is the Product Details tab
        if (buttonText.includes('Product Details')) {
          console.log('Found Product Details tab! Opening...');
          
          // Force open state
          answerDiv.style.display = 'block';
          answerDiv.style.height = 'auto';
          answerDiv.style.paddingTop = '10px';
          answerDiv.style.paddingBottom = '20px';
          answerDiv.style.opacity = '1';
          answerDiv.style.visibility = 'visible';
          
          // Rotate arrow
          arrowIcon.style.setProperty('--rotate', '180deg', 'important');
          
          console.log('Product Details tab opened successfully!');
          
          // Block all click events on this tab
          const clickBlocker = function(e) {
            console.log('Click blocked on Product Details tab');
            e.preventDefault();
            e.stopPropagation();
            e.stopImmediatePropagation();
            
            // Force it to stay open
            answerDiv.style.display = 'block';
            answerDiv.style.height = 'auto';
            arrowIcon.style.setProperty('--rotate', '180deg', 'important');
            
            return false;
          };
          
          // Add click blockers
          buttonDiv.addEventListener('click', clickBlocker, true);
          container.addEventListener('click', clickBlocker, true);
          
          // Watch for any changes and revert them
          const observer = new MutationObserver(function(mutations) {
            mutations.forEach(function(mutation) {
              if (mutation.target === answerDiv && mutation.attributeName === 'style') {
                const display = answerDiv.style.display;
                if (display === 'none' || display === '') {
                  console.log('Tab was closed, reopening...');
                  answerDiv.style.display = 'block';
                  answerDiv.style.height = 'auto';
                  answerDiv.style.paddingTop = '10px';
                  answerDiv.style.paddingBottom = '20px';
                  arrowIcon.style.setProperty('--rotate', '180deg', 'important');
                }
              }
            });
          });
          
          observer.observe(answerDiv, { 
            attributes: true, 
            attributeFilter: ['style'] 
          });
        }
      }
    });
  }
  
  // Try multiple times with different delays
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function() {
      forceTabOpen();
      setTimeout(forceTabOpen, 500);
      setTimeout(forceTabOpen, 1000);
      setTimeout(forceTabOpen, 2000);
    });
  } else {
    forceTabOpen();
    setTimeout(forceTabOpen, 500);
    setTimeout(forceTabOpen, 1000);
    setTimeout(forceTabOpen, 2000);
  }
  
  // Also run when window loads
  window.addEventListener('load', function() {
    setTimeout(forceTabOpen, 100);
  });
  
})();
</script>

