      /* Low-stock inventory icon pulse */
.flash-inventory {
  overflow: visible; /* lets the ring expand past the 15x15 viewport */
}

.flash-inventory__dot {
  transform-box: fill-box;
  transform-origin: center;
  animation: flash-inventory-dot 1.2s ease-in-out infinite;
}

.flash-inventory__ring {
  transform-box: fill-box;
  transform-origin: center;
  animation: flash-inventory-ring 1.2s ease-out infinite;
}

@keyframes flash-inventory-dot {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.45; }
}

@keyframes flash-inventory-ring {
  0% { transform: scale(1); opacity: 0.4; }
  70% { transform: scale(1.8); opacity: 0; }
  100% { transform: scale(1.8); opacity: 0; }
}

@media (prefers-reduced-motion: reduce) {
  .flash-inventory__dot,
  .flash-inventory__ring {
    animation: none;
  }
}
