{"sections":{"color_variant_links":{"type":"custom-liquid","disabled":true,"settings":{"custom_liquid":"{% render 'color-variant-links' %}","color_scheme":"","padding_top":40,"padding_bottom":52}},"main":{"type":"main-product","blocks":{"growave_loyalty_wishlist_block_product_review_avg_profile_Gz6Rh7":{"type":"shopify:\/\/apps\/growave-loyalty-wishlist\/blocks\/block.product.reviewAvgProfile\/b3d2efbe-110a-4e27-84a8-1f2ed63996a4","disabled":true,"settings":{"custom_css":"","element_to_scroll_id":"","element_to_click_id":""}},"title":{"type":"title","settings":{}},"vendor":{"type":"text","settings":{"text":"","text_style":"uppercase"}},"price":{"type":"price","disabled":true,"settings":{}},"variant_picker":{"type":"variant_picker","settings":{"picker_type":"button","swatch_shape":"square"}},"inventory_m8rnKD":{"type":"inventory","disabled":true,"settings":{"text_style":"uppercase","inventory_threshold":1,"show_inventory_quantity":false}},"kiwi_size_chart_recommender_kiwi_sizing_xWa4MH":{"type":"shopify:\/\/apps\/kiwi-size-chart-recommender\/blocks\/kiwiSizing\/b7369922-bf15-44ce-a121-a22a8fcbc4b0","settings":{"fallbackToBlockPosition":false,"waitForElementSelector":"","waitForElementDelay":1}},"growave_loyalty_wishlist_block_product_earn_points_widget_WiXxKQ":{"type":"shopify:\/\/apps\/growave-loyalty-wishlist\/blocks\/block.product.earnPointsWidget\/b3d2efbe-110a-4e27-84a8-1f2ed63996a4","settings":{"font_color":"#121212","background_color":"#f8f8f8","widget_view":"points","custom_css":""}},"custom_liquid_QVHhqV":{"type":"custom_liquid","disabled":true,"settings":{"custom_liquid":"<div class=\"viewing-now\" data-min=\"2\" data-max=\"20\">\n  <svg class=\"viewing-now__icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\">\n    <path d=\"M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z\"\/>\n    <circle cx=\"12\" cy=\"12\" r=\"3\"\/>\n  <\/svg>\n  <span><span class=\"viewing-now__count\">12<\/span> people are viewing this product<\/span>\n<\/div>\n\n<style>\n  .viewing-now {\n    display: flex;\n    align-items: center;\n    gap: 10px;\n    font-size: 12px;\n    font-weight: 400;\n    letter-spacing: 0.08em;\n    text-transform: uppercase;\n    color: #000;            \/* text colour *\/\n    line-height: 1.2;\n  }\n  .viewing-now__icon {\n    width: 22px;\n    height: 22px;\n    flex-shrink: 0;\n  }\n  .viewing-now__count {\n    font-weight: 500;\n  }\n<\/style>\n\n<script>\n  (function () {\n    function rand(min, max) {\n      return Math.floor(Math.random() * (max - min + 1)) + min;\n    }\n\n    document.querySelectorAll('.viewing-now:not([data-init])').forEach(function (el) {\n      el.setAttribute('data-init', 'true');\n\n      var min = parseInt(el.getAttribute('data-min'), 10) || 2;\n      var max = parseInt(el.getAttribute('data-max'), 10) || 20;\n      var countEl = el.querySelector('.viewing-now__count');\n      var current = rand(min, max);\n      countEl.textContent = current;\n\n      function tick() {\n        \/\/ 65% chance to move by 1, otherwise hold steady\n        var step = Math.random() < 0.65 ? (Math.random() < 0.5 ? -1 : 1) : 0;\n        current = Math.min(max, Math.max(min, current + step));\n        countEl.textContent = current;\n        setTimeout(tick, rand(2500, 5500));\n      }\n      setTimeout(tick, rand(2500, 5500));\n    });\n  })();\n<\/script>"}},"custom_liquid_NebT3V":{"type":"custom_liquid","settings":{"custom_liquid":"{% comment %}\n  Variant Inventory Countdown — Custom Liquid Block\n  Paste into a Custom Liquid block on your product page.\n  Hides automatically on preorder\/0-stock products.\n{% endcomment %}\n\n{% assign current_variant = product.selected_or_first_available_variant %}\n{% assign max_inventory = 10 %}\n\n<div id=\"inventory-countdown\" style=\"\n  display: none;\n  background: #f5f5f5;\n  border-radius: 12px;\n  padding: 14px 20px;\n  margin: 4px 0;\n\">\n  <p id=\"inventory-text\" style=\"\n    font-size: 15px;\n    font-weight: 500;\n    color: #1a1a1a;\n    margin: 0 0 10px 0;\n    text-align: left;\n    letter-spacing: 0.01em;\n  \">\n    <span id=\"inventory-count\">{{ current_variant.inventory_quantity }}<\/span> remaining\n  <\/p>\n  <div style=\"\n    width: 100%;\n    height: 15px;\n    background: #e0e0e0;\n    border-radius: 99px;\n    overflow: hidden;\n  \">\n    <div id=\"inventory-bar\" style=\"\n      height: 100%;\n      background: #222;\n      border-radius: 99px;\n      transition: width 0.4s ease;\n      width: 0%;\n      font-size: 0;\n      line-height: 0;\n    \">&nbsp;<\/div>\n  <\/div>\n<\/div>\n\n<script>\n(function() {\n  var variantData = {};\n  var maxInventory = {{ max_inventory }};\n\n  {% for variant in product.variants %}\n    {% if variant.inventory_management == 'shopify' %}\n      variantData[{{ variant.id }}] = {{ variant.inventory_quantity }};\n    {% endif %}\n  {% endfor %}\n\n  function updateInventory(variantId) {\n    var wrapper = document.getElementById('inventory-countdown');\n    var countEl = document.getElementById('inventory-count');\n    var barEl = document.getElementById('inventory-bar');\n\n    if (!wrapper || !countEl || !barEl) return;\n\n    var qty = variantData[variantId];\n\n    if (typeof qty !== 'undefined' && qty > 0) {\n      countEl.textContent = qty;\n      var pct = Math.min((qty \/ maxInventory) * 100, 100);\n      barEl.style.width = pct + '%';\n      wrapper.style.display = 'block';\n    } else {\n      wrapper.style.display = 'none';\n    }\n  }\n\n  updateInventory({{ current_variant.id }});\n\n  document.addEventListener('change', function(e) {\n    var el = e.target;\n    if (el.name === 'id' || el.closest('[data-variant-id]') || el.closest('variant-selects') || el.closest('variant-radios')) {\n      setTimeout(function() {\n        var input = document.querySelector('input[name=\"id\"][type=\"hidden\"]') || document.querySelector('select[name=\"id\"]');\n        if (input) updateInventory(parseInt(input.value));\n      }, 50);\n    }\n  });\n\n  var pushState = history.pushState;\n  history.pushState = function() {\n    pushState.apply(history, arguments);\n    var params = new URLSearchParams(window.location.search);\n    var vid = params.get('variant');\n    if (vid) updateInventory(parseInt(vid));\n  };\n\n  window.addEventListener('popstate', function() {\n    var params = new URLSearchParams(window.location.search);\n    var vid = params.get('variant');\n    if (vid) updateInventory(parseInt(vid));\n  });\n})();\n<\/script>"}},"delivery_countdown_BNBMTP":{"type":"delivery_countdown","disabled":true,"settings":{"home_country":"GB","lead_before":"For next day delivery","lead_after":"; order within","intl_text":"Ships from UK duties and taxes paid","cutoff_hour":15,"cutoff_minute":0,"dispatch_days":"mon_fri","delivery_days":"mon_sat","show_icon":true,"text_color":"#6b7280"}},"buy_buttons":{"type":"buy_buttons","settings":{"show_dynamic_checkout":false,"show_gift_card_recipient":true}},"growave_loyalty_wishlist_block_product_fave_button_EeMV89":{"type":"shopify:\/\/apps\/growave-loyalty-wishlist\/blocks\/block.product.faveButton\/b3d2efbe-110a-4e27-84a8-1f2ed63996a4","settings":{"icon_only":false,"option_button_class":"","custom_css":"","shadow_root_options":"null"}},"custom_liquid_WcyxbM":{"type":"custom_liquid","settings":{"custom_liquid":"<div class=\"klarna-line\">\n  <span class=\"klarna-line__text\">pay in 30 days or 3 instalments with<\/span>\n  <span class=\"klarna-line__brand\">Klarna<span class=\"klarna-line__dot\">.<\/span><\/span>\n<\/div>\n\n<style>\n  .klarna-line {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 6px;\n    font-size: 13px;\n    color: #1a1a1a;\n    line-height: 1.3;\n    padding: 4px 0;\n  }\n  .klarna-line__brand {\n    font-weight: 700;\n    color: #000;\n    letter-spacing: -0.01em;\n  }\n  .klarna-line__dot {\n    color: #ffb3c7;   \/* Klarna 