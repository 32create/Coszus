{"layout":"password","sections":{"main":{"type":"email-signup-banner","blocks":{"heading":{"type":"heading","settings":{"heading":"VIP EARLY ACCESS","heading_size":"h2"}},"paragraph":{"type":"paragraph","settings":{"text":"","text_style":"body"}},"email_form":{"type":"email_form","settings":{}}},"block_order":["heading","paragraph","email_form"],"disabled":true,"settings":{"image":"shopify:\/\/shop_images\/IMG_4677_62e2bc53-4727-47e9-81b7-bd7726b26388.jpg","image_overlay_opacity":20,"show_background_image":true,"image_height":"adapt-image","desktop_content_position":"middle-center","show_text_box":true,"desktop_content_alignment":"center","color_scheme":"scheme-1","mobile_content_alignment":"center","show_text_below":false}},"custom_liquid_NfLF93":{"type":"custom-liquid","name":"t:sections.custom-liquid.presets.name","settings":{"custom_liquid":"<style>\n  .lock-screen {\n    position: fixed;\n    top: 0;\n    left: 0;\n    width: 100vw;\n    height: 100vh;\n    background-color: black;\n    color: white;\n    z-index: 9999999999;\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    font-family: Arial, sans-serif;\n    font-size: 24px;\n    overflow-y: auto;\n    overflow-x: hidden;\n    padding: 50px 0px;\n  }\n\n  \/* Prevent scrolling on the body when lock screen is active *\/\n  .lock-screen-active {\n    overflow: hidden;\n    height: 100vh;\n  }\n\n  .lock-screen h2 {\n    font-size: 30px;\n  }\n\n  .lock-screen h3 {\n    font-size: 24px;\n  }\n\n  .lock-screen p {\n    font-size: 18px;\n  }\n\n  #show-newsletter-btn {\n    font-size: 18px;\n    background: transparent;\n    border: 0px;\n  }\n\n  #show-password-btn {\n    background: transparent;\n    border: 0px;\n    color: white;\n  }\n\n  .form {\n    align-content: start;\n    row-gap: 20px;\n    display: flex !important;\n    flex-direction: column;\n  }\n\n  .password-form {\n    gap: 20px;\n    margin-top: 0px !important;\n  }\n\n  .password-form .password-field.field {\n    flex: 1 100% !important;\n    border: 1px solid #fff;\n  }\n\n  .password-form .field__input,\n  .customer .field input {\n    margin: 0px;\n    color: black;\n  }\n\n  .password-form .field__label {\n    color: black;\n  }\n\n  .password-form .password-button {\n    width: 100%;\n    margin: 0px !important;\n    background: white;\n    color: black;\n    font-weight: 700;\n  }\n\n  @media (max-width: 767px) {\n    .lock-screen {\n      align-items: start;\n    }\n\n    .lock-screen h2 {\n      font-size: 21px;\n    }\n\n    .lock-screen h3 {\n      font-size: 17px;\n    }\n\n    .lock-screen p {\n      font-size: 14px;\n    }\n\n    #show-newsletter-btn {\n      font-size: 14px;\n    }\n  }\n<\/style>\n\n<div id=\"lock-screen\" class=\"lock-screen\">\n  <div class=\"main-shop-password-container\" style=\"max-width: 1000px; margin: 0px auto;\">\n    <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0526\/5178\/6436\/files\/Bazaart_220A1138-24B5-4B65-AA44-157305DAEA75.png?v=1763839685\"\n      alt=\"Mirage Perfume Logo\" style=\"display: block; margin: 0px auto 0px auto; with:100%; max-width:200px;\" \/>\n    <h1 style=\"padding: 0px 20px; text-align: center; margin-top: 0px !important;\">SUMMER SALE <\/h1>\n    <h3 style=\"padding: 0px 20px; text-align: center;\">\n      <span id=\"discount-line\">7PM BST <br \/>Limited Stock Available<\/span>\n    <\/h3>\n    <hr style=\"margin: 20px 0px; text-align: center;\" \/>\n    <p style=\"padding: 0px 20px; text-align: center;\">Enter password below to access the store:<\/p>\n    <div style=\"padding: 20px 20px; text-align: center; max-width: 1000px; margin: 0px auto;\">\n      {%- form 'storefront_password', class: 'password-form' -%}\n      <div class=\"password-field field{% if form.errors %} password-field--error{% endif %}\">\n        <input type=\"password\" name=\"password\" id=\"Password\" class=\"field__input\" autocomplete=\"current-password\" {% if\n          form.errors %} aria-invalid=\"true\" aria-describedby=\"PasswordLoginForm-password-error\" {%- endif -%}\n          placeholder=\"{{ 'general.password_page.login_form_password_placeholder' | t }}\" \/>\n        <label class=\"field__label\" for=\"{{ 'general.password_page.login_form_password_label' | t }}\"> {{-\n          'general.password_page.login_form_password_placeholder' | t -}} <\/label>\n        {%- if form.errors -%}\n        <div id=\"PasswordLoginForm-password-error\" role=\"status\">\n          <span class=\"visually-hidden\">{{ 'accessibility.error' | t }}<\/span>\n          <span class=\"form__message\"> {%- render 'icon-error' %} {{ 'general.password_page.login_form_error' | t -}}\n          <\/span>\n        <\/div>\n        {%- endif -%}\n      <\/div>\n      <button name=\"commit\" class=\"password-button button button--outline\">{{ 'general.password_page.login_form_submit'\n        | t }}<\/button>\n      {%- endform -%}\n    <\/div>\n    <button id=\"show-newsletter-btn\" style=\"width: 100%; text-align: center;\">Didn't get your early access code?\n      <br \/><span style=\"color: #fff;\">Click here to request it again<\/span><\/button>\n  <\/div>\n  <div class=\"password__block-list\" style=\"display: none;\">\n    <div class=\"password__content color-scheme color-scheme--{{ block.settings.color_scheme.id }}\" {{\n      block.shopify_attributes }} style=\"padding: 10px 20px;\">\n      <div id=\"klaviyo-forms\">\n        <div class=\"klaviyo-form-RCip6V\"><\/div>\n      <\/div>\n    <\/div>\n    <button id=\"show-password-btn\" class=\"text-center\">To enter the password. <span style=\"color: #fff;\">Click\n        here<\/span><\/button>\n  <\/div>\n<\/div>\n\n<script>\n  document.addEventListener('DOMContentLoaded', function () {\n    \/\/ Add class to body to prevent scrolling\n    document.body.classList.add('lock-screen-active');\n\n    var showNewsletterBtn = document.getElementById('show-newsletter-btn');\n    var showPasswordBtn = document.getElementById('show-password-btn');\n    var mainContainer = document.querySelector('.main-shop-password-container');\n    var blockList = document.querySelector('.password__block-list');\n\n    if (showNewsletterBtn) {\n      showNewsletterBtn.addEventListener('click', function () {\n        if (mainContainer) mainContainer.style.display = 'none';\n        if (blockList) blockList.style.display = '';\n      });\n    }\n    if (showPasswordBtn) {\n      showPasswordBtn.addEventListener('click', function () {\n        if (mainContainer) mainContainer.style.display = '';\n        if (blockList) blockList.style.display = 'none';\n      });\n    }\n  });\n<\/script>","color_scheme":"","padding_top":40,"padding_bottom":52}}},"order":["main","custom_liquid_NfLF93"]}