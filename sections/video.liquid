{% comment %}
  Section: Video with text (Studio theme compatible)
  - Uses same setting IDs as Image with text, so headings/text/buttons stay intact
  - Video is added via a URL field (paste link from Settings > Files)
{% endcomment %}

<section id="video-with-text-{{ section.id }}" class="section color-{{ section.settings.color_scheme }}">
  <style>
    #video-with-text-{{ section.id }} .vwt-wrapper {
      display: grid;
      gap: 24px;
      align-items: center;
    }
    @media (min-width: 750px) {
      #video-with-text-{{ section.id }} .vwt-wrapper { grid-template-columns: 1fr 1fr; }
      {% if section.settings.desktop_image_position == 'right' %}
        #video-with-text-{{ section.id }} .vwt-media { order: 2; }
        #video-with-text-{{ section.id }} .vwt-content { order: 1; }
      {% endif %}
    }
    #video-with-text-{{ section.id }} .vwt-media {
      width: 100%;
      position: relative;
      overflow: hidden;
      border-radius: {% if section.settings.rounded_corners %}12px{% else %}0{% endif %};
    }
    #video-with-text-{{ section.id }} .vwt-media::before {
      content: "";
      display: block;
      padding-bottom:
        {% case section.settings.image_ratio %}
          {% when '16-9' %}56.25%
          {% when '4-3' %}75%
          {% when '1-1' %}100%
          {% when '3-4' %}133.3333%
          {% when '9-16' %}177.7778%
          {% else %}56.25%
        {% endcase %};
    }
    #video-with-text-{{ section.id }} .vwt-media > * {
      position: absolute; inset: 0; width: 100%; height: 100%;
      object-fit: {{ section.settings.image_fit }};
    }
    #video-with-text-{{ section.id }} .vwt-content {
      text-align:
        {% case section.settings.text_alignment %}
          {% when 'left' %} left
          {% when 'center' %} center
          {% when 'right' %} right
        {% endcase %};
    }
    #video-with-text-{{ section.id }} .vwt-heading { margin: 0 0 12px; }
    #video-with-text-{{ section.id }} .vwt-text { margin: 0 0 16px; }
    #video-with-text-{{ section.id }} .vwt-btn {
      display: inline-block; padding: 12px 18px;
      text-decoration: none; border: 1px solid currentColor; border-radius: 8px;
    }
    #video-with-text-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  </style>

  <div class="page-width">
    <div class="vwt-wrapper">
      <div class="vwt-media">
        {% if section.settings.video_url != blank %}
          <video
            {% if section.settings.autoplay %}autoplay{% endif %}
            {% if section.settings.loop %}loop{% endif %}
            {% if section.settings.muted %}muted{% endif %}
            {% if section.settings.playsinline %}playsinline{% endif %}
            {% if section.settings.controls %}controls{% endif %}
            {% if section.settings.image != blank %}poster="{{ section.settings.image | image_url: width: 1600 }}"{% endif %}
          >
            <source src="{{ section.settings.video_url }}" type="video/mp4">
            <source src="{{ section.settings.video_url }}">
            Your browser does not support the video tag.
          </video>
        {% elsif section.settings.image != blank %}
          {{ section.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', alt: section.settings.heading | escape }}
        {% else %}
          <div style="display:flex;align-items:center;justify-content:center;height:100%;background:#f3f3f3;color:#777;">
            <span>Add a video URL in the section settings</span>
          </div>
        {% endif %}
      </div>

      <div class="vwt-content">
        {% if section.settings.subheading != blank %}
          <p class="vwt-subheading">{{ section.settings.subheading }}</p>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 class="vwt-heading">{{ section.settings.heading | escape }}</h2>
        {% endif %}
        {% if section.settings.text != blank %}
          <div class="vwt-text">{{ section.settings.text }}</div>
        {% endif %}
        {% if section.settings.button_label != blank and section.settings.button_link != blank %}
          <a class="vwt-btn" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }}</a>
        {% endif %}
      </div>
    </div>
  </div>

  {% schema %}
  {
    "name": "Video with text",
    "settings": [
      { "type": "url", "id": "video_url", "label": "Video URL (from Settings > Files)" },
      { "type": "image_picker", "id": "image", "label": "Poster image (fallback/thumbnail)" },

      {
        "type": "select", "id": "image_ratio", "label": "Media aspect ratio", "default": "16-9",
        "options": [
          { "value": "16-9", "label": "16:9 (landscape)" },
          { "value": "4-3", "label": "4:3" },
          { "value": "1-1", "label": "1:1 (square)" },
          { "value": "3-4", "label": "3:4 (portrait)" },
          { "value": "9-16", "label": "9:16 (tall)" }
        ]
      },
      {
        "type": "select", "id": "image_fit", "label": "Video fit", "default": "cover",
        "options": [
          { "value": "cover", "label": "Cover (crop to fill)" },
          { "value": "contain", "label": "Contain (no crop)" }
        ]
      },
      {
        "type": "select", "id": "desktop_image_position", "label": "Media position on desktop",
        "default": "left",
        "options": [ { "value": "left", "label": "Left" }, { "value": "right", "label": "Right" } ]
      },
      {
        "type": "select", "id": "text_alignment", "label": "Text alignment",
        "default": "left",
        "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" } ]
      },
      { "type": "checkbox", "id": "rounded_corners", "label": "Rounded media corners", "default": true },

      { "type": "header", "content": "Playback" },
      { "type": "checkbox", "id": "autoplay", "label": "Autoplay", "default": true },
      { "type": "checkbox", "id": "loop", "label": "Loop", "default": true },
      { "type": "checkbox", "id": "muted", "label": "Muted (required for autoplay on mobile)", "default": true },
      { "type": "checkbox", "id": "playsinline", "label": "Plays inline (mobile)", "default": true },
      { "type": "checkbox", "id": "controls", "label": "Show controls", "default": false },

      { "type": "header", "content": "Content" },
      { "type": "text", "id": "subheading", "label": "Subheading" },
      { "type": "text", "id": "heading", "label": "Heading", "default": "Your heading here" },
      { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Add some supporting copy here.</p>" },
      { "type": "text", "id": "button_label", "label": "Button label" },
      { "type": "url", "id": "button_link", "label": "Button link" },

      { "type": "header", "content": "Section style" },
      { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "background-1" },
      { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding top", "default": 56 },
      { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding bottom", "default": 56 }
    ],
    "presets": [ { "name": "Video with text", "category": "Media" } ]
  }
  {% endschema %}
</section>