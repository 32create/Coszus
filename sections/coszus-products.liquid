{%- if section.settings.collection == blank or section.settings.collection.products_count > 0 -%}
{%- comment -%} Coszus product row: New in / The sale / Last sizes. {%- endcomment -%}
{%- assign col = section.settings.collection -%}
<section class="cz cz-row">
  <div class="cz-row-hd">
    <div>
      <h2 class="cz-h2"{% if section.settings.red %} style="color:var(--cz-red);"{% endif %}>{{ section.settings.heading }}</h2>
      {%- if section.settings.sub != blank -%}<div class="cz-row-sub">{{ section.settings.sub }}</div>{%- endif -%}
    </div>
    {%- if section.settings.link_label != blank -%}<a class="cz-ul" href="{{ section.settings.link_url | default: col.url }}">{{ section.settings.link_label }}</a>{%- endif -%}
  </div>
  <div class="cz-grid{% if section.settings.cols == '6' %} six{% endif %}">
    {%- if col != blank -%}
      {%- for product in col.products limit: section.settings.limit -%}{%- render 'coszus-card', product: product -%}{%- endfor -%}
    {%- else -%}
      {%- for i in (1..6) -%}<div class="cz-card"><div class="cz-img">{{ 'product-apparel-1' | placeholder_svg_tag }}</div></div>{%- endfor -%}
    {%- endif -%}
  </div>
</section>
{%- endif -%}
{% schema %}
{
  "name": "Coszus product row",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "NEW IN" },
    { "type": "text", "id": "sub", "label": "Line under the heading" },
    { "type": "checkbox", "id": "red", "label": "Red heading (sale)", "default": false },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Products", "min": 2, "max": 24, "step": 1, "default": 6 },
    { "type": "select", "id": "cols", "label": "Across on desktop", "options": [ { "value": "6", "label": "6" }, { "value": "4", "label": "4" } ], "default": "6" },
    { "type": "text", "id": "link_label", "label": "Link text", "default": "View all" },
    { "type": "url", "id": "link_url", "label": "Link", "info": "Defaults to the collection" }
  ],
  "presets": [ { "name": "Coszus product row" } ]
}
{% endschema %}
