{%- comment -%}
  Coszus header, from the mockup: scrolling announcement bar, brown logo bar,
  white category bar, full-screen mobile menu. The bag keeps id="cart-icon-bubble"
  so the theme's cart drawer (and Kaching) still open from it and update its count.
{%- endcomment -%}
{%- liquid
  assign logo = section.settings.logo | default: settings.logo
  assign menu = linklists[section.settings.menu]
  assign help_menu = linklists[section.settings.help_menu]
-%}

<div class="cz">
  {%- if section.blocks.size > 0 -%}
    <div class="cz-ann" role="region" aria-label="{% for block in section.blocks %}{{ block.settings.text | escape }}{% unless forloop.last %}, {% endunless %}{% endfor %}">
      <div class="cz-mq" aria-hidden="true">
        {%- for i in (1..2) -%}
          {%- if settings.bf_tagline != blank -%}<span data-bf-on class="cz-bf-msg">{{ settings.bf_tagline | upcase }}</span>{%- endif -%}
          {%- if settings.bf_offer != blank -%}<span data-bf-on class="cz-bf-msg">{{ settings.bf_offer | upcase }}</span>{%- endif -%}
          {%- for block in section.blocks -%}
            <span {% if i == 1 %}{{ block.shopify_attributes }}{% endif %}>{{ block.settings.text | upcase }}</span>
          {%- endfor -%}
        {%- endfor -%}
        {%- if section.blocks.size < 4 -%}
          {%- for block in section.blocks -%}<span>{{ block.settings.text | upcase }}</span>{%- endfor -%}
          {%- for block in section.blocks -%}<span>{{ block.settings.text | upcase }}</span>{%- endfor -%}
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}

  <nav class="cz-mnu" id="CzMenu" aria-label="Menu" aria-hidden="true">
    <div class="cz-mnu-top">
      <button type="button" class="cz-mnu-x" data-cz-close>
        <svg width="16" height="12" viewBox="0 0 16 12" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M15 6H1M6 1L1 6l5 5"/></svg>Close
      </button>
      {%- if section.settings.logo_dark != blank -%}
        {{ section.settings.logo_dark | image_url: width: 300 | image_tag: alt: shop.name, loading: 'lazy' }}
      {%- endif -%}
    </div>
    <form action="{{ routes.search_url }}" method="get" role="search" class="cz-msearch" data-cz-search-open data-cz-close>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#1d1715" stroke-width="1.6" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg>
      <label class="cz-vh" for="CzMenuSearch">Search</label>
      <input id="CzMenuSearch" type="search" name="q" placeholder="Search for…">
      <input type="hidden" name="options[prefix]" value="last">
    </form>
    <div class="cz-ml-list">
      {%- if settings.bf_collection != blank -%}<a class="cz-ml sale" href="{{ settings.bf_collection.url }}" data-bf-on>{{ settings.bf_name | default: 'Black Friday' }}<span>›</span></a>{%- endif -%}
      {%- for link in menu.links -%}
        {%- assign t = link.title | downcase -%}
        <a class="cz-ml{% if t contains 'sale' %} sale{% endif %}" href="{{ link.url }}">{{ link.title }}<span>›</span></a>
      {%- endfor -%}
    </div>
    {%- if section.settings.promo_title != blank -%}
      <a class="cz-promo" href="{{ section.settings.promo_url | default: '#' }}">
        {%- if section.settings.promo_image != blank -%}
          {{ section.settings.promo_image | image_url: width: 900 | image_tag: alt: '', loading: 'lazy' }}
        {%- endif -%}
        <span><small>{{ section.settings.promo_kicker }}</small><b>{{ section.settings.promo_title }}</b><em>{{ section.settings.promo_text }}</em></span>
      </a>
    {%- endif -%}
    {%- if help_menu.links.size > 0 -%}
      <div class="cz-mlinks">
        {%- for link in help_menu.links -%}<a href="{{ link.url }}">{{ link.title }}</a>{%- endfor -%}
      </div>
    {%- endif -%}
    <div class="cz-mloc">{{ localization.country.iso_code }} / {{ cart.currency.symbol }} / English</div>
  </nav>


  <div class="cz-srch" id="CzSearch" hidden>
    <div class="cz-srch-p" role="dialog" aria-modal="true" aria-label="Search">
      <form action="{{ routes.search_url }}" method="get" role="search" class="cz-srch-f">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg>
        <label class="cz-vh" for="CzSearchInput">Search</label>
        <input id="CzSearchInput" type="search" name="q" placeholder="Search hoodies, caps, polos…" autocomplete="off" data-cz-search-input>
        <input type="hidden" name="options[prefix]" value="last">
        <button type="button" class="cz-srch-x" data-cz-search-close aria-label="Close search">×</button>
      </form>
      <div class="cz-srch-b">
        <div class="cz-srch-pop" data-cz-search-pop>
          <small>POPULAR</small>
          <div>{%- for link in menu.links limit: 8 -%}<a href="{{ link.url }}">{{ link.title }}</a>{%- endfor -%}</div>
        </div>
        <div class="cz-srch-res" data-cz-search-res hidden>
          <div class="cz-grid six" data-cz-search-grid></div>
          <a class="cz-srch-all" href="#" data-cz-search-all>SEE ALL RESULTS</a>
        </div>
        <p class="cz-srch-none" data-cz-search-none hidden>Nothing for that. Try "hoodie", "cap" or "polo".</p>
      </div>
    </div>
  </div>
  <div class="cz-hd">
    <div class="cz-hbar">
      <div style="display:flex;align-items:center;">
        <button type="button" class="cz-ib cz-mb" data-cz-open aria-label="Open menu" aria-controls="CzMenu" aria-expanded="false">
          <svg width="20" height="14" viewBox="0 0 20 14" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M0 1h20M0 7h20M0 13h20"/></svg>
        </button>
        <a class="cz-ib" href="{{ routes.search_url }}" aria-label="Search" data-cz-search-open>
          <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg>
        </a>
      </div>
      <a class="cz-logo" href="{{ routes.root_url }}" aria-label="{{ shop.name }} home">
        {%- if logo != blank -%}
          {%- assign lcls = '' -%}{%- if section.settings.logo_invert -%}{%- assign lcls = 'inv' -%}{%- endif -%}
          {{ logo | image_url: width: 400 | image_tag: alt: shop.name, preload: true, class: lcls }}
        {%- else -%}
          <span>{{ shop.name }}</span>
        {%- endif -%}
      </a>
      <div class="cz-hr">
        {%- if shop.customer_accounts_enabled -%}
          <a class="cz-ib cz-dk" href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" aria-label="Account">
            <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6"/></svg>
          </a>
        {%- endif -%}
        <a href="{{ routes.cart_url }}" class="cz-ib header__icon header__icon--cart" id="cart-icon-bubble">
          {%- liquid
            if cart == empty
              render 'icon-cart-empty'
            else
              render 'icon-cart'
            endif
          -%}
          <span class="visually-hidden">{{ 'templates.cart.cart' | t }}</span>
          {%- if cart != empty -%}
            <div class="cart-count-bubble">
              {%- if cart.item_count < 100 -%}<span aria-hidden="true">{{ cart.item_count }}</span>{%- endif -%}
              <span class="visually-hidden">{{ 'sections.header.cart_count' | t: count: cart.item_count }}</span>
            </div>
          {%- endif -%}
        </a>
      </div>
    </div>
    {%- if settings.bf_collection != blank -%}
      <a class="cz-bfstrip" href="{{ settings.bf_collection.url }}" data-bf-on aria-label="{{ settings.bf_tagline | escape }}">
        <span class="cz-bfstrip-mq" aria-hidden="true">
          {%- for i in (1..8) -%}<span><b>{{ settings.bf_name | upcase }}</b> {{ settings.bf_tagline | remove: settings.bf_name | remove_first: '·' | strip | upcase }}</span><i>●</i><span>{{ settings.bf_offer | upcase }}</span><i>●</i>{%- endfor -%}
        </span>
      </a>
    {%- endif -%}
    {%- if menu.links.size > 0 -%}
      <nav class="cz-cbar" aria-label="Categories">
        {%- if settings.bf_collection != blank -%}<a href="{{ settings.bf_collection.url }}" class="sale" data-bf-on>{{ settings.bf_name | default: 'Black Friday' | upcase }}</a>{%- endif -%}
        {%- for link in menu.links -%}
          {%- assign t = link.title | downcase -%}
          <a href="{{ link.url }}" class="{% if t contains 'sale' %}sale{% elsif link.active or link.child_active %}on{% endif %}"{% if link.active %} aria-current="page"{% endif %}>{{ link.title }}</a>
        {%- endfor -%}
      </nav>
    {%- endif -%}
  </div>
</div>

<script>
(function () {
  var p = document.getElementById('CzSearch'); if (!p || p.dataset.ready) return; p.dataset.ready = '1';
  var input = p.querySelector('[data-cz-search-input]'), grid = p.querySelector('[data-cz-search-grid]'), res = p.querySelector('[data-cz-search-res]'), pop = p.querySelector('[data-cz-search-pop]'), none = p.querySelector('[data-cz-search-none]'), all = p.querySelector('[data-cz-search-all]');
  var t, ctl, fmt = {{ shop.money_format | json }};
  var money = function (v) { var n = Number(v); if (isNaN(n)) n = parseFloat(v); return fmt.replace(/\{\{\s*\w+\s*\}\}/, n.toFixed(2)); };
  function open() { p.hidden = false; document.documentElement.style.overflow = 'hidden'; setTimeout(function () { input.focus(); }, 30); }
  function close() { p.hidden = true; document.documentElement.style.overflow = ''; }
  function esc(x) { var d = document.createElement('div'); d.textContent = x == null ? '' : x; return d.innerHTML; }
  function run(q) {
    if (ctl) ctl.abort(); ctl = window.AbortController ? new AbortController() : null;
    if (q.length < 2) { res.hidden = true; none.hidden = true; pop.hidden = false; return; }
    fetch('{{ routes.predictive_search_url }}.json?q=' + encodeURIComponent(q) + '&resources[type]=product&resources[limit]=6&resources[options][unavailable_products]=last', ctl ? { signal: ctl.signal } : {})
      .then(function (r) { return r.json(); }).then(function (j) {
        var ps = (j.resources && j.resources.results && j.resources.results.products) || [];
        pop.hidden = true; all.href = '{{ routes.search_url }}?q=' + encodeURIComponent(q) + '&options[prefix]=last';
        if (!ps.length) { res.hidden = true; none.hidden = false; return; }
        none.hidden = true; res.hidden = false;
        grid.innerHTML = ps.map(function (x) {
          var img = x.featured_image && x.featured_image.url ? x.featured_image.url : (x.image || '');
          if (img) img += (img.indexOf('?') > -1 ? '&' : '?') + 'width=500';
          var sale = Number(x.compare_at_price_max) > Number(x.price);
          return '<a class="cz-mini" href="' + x.url + '"><span class="cz-mini-i">' + (img ? '<img loading="lazy" alt="" src="' + img + '">' : '') + '</span><span class="cz-nr"><span class="cz-pn">' + esc(x.title) + '</span><span class="cz-pr">' + (sale ? '<s>' + money(x.compare_at_price_max) + '</s> <b>' + money(x.price) + '</b>' : money(x.price)) + '</span></span></a>';
        }).join('');
      }).catch(function () {});
  }
  document.addEventListener('click', function (e) {
    if (e.target.closest('[data-cz-search-open]')) { e.preventDefault(); open(); }
    else if (e.target.closest('[data-cz-search-close]') || e.target === p) close();
  });
  input.addEventListener('input', function () { clearTimeout(t); var q = input.value.trim(); t = setTimeout(function () { run(q); }, 180); });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !p.hidden) close(); });
})();

  (function () {
    var m = document.getElementById('CzMenu');
    if (!m || m.dataset.ready) return;
    m.dataset.ready = '1';
    var openBtn = document.querySelector('[data-cz-open]');
    function set(open) {
      m.classList.toggle('open', open);
      m.setAttribute('aria-hidden', open ? 'false' : 'true');
      if (openBtn) openBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
      document.documentElement.style.overflow = open ? 'hidden' : '';
      if (!open && openBtn) openBtn.focus();
    }
    document.addEventListener('click', function (e) {
      if (e.target.closest('[data-cz-open]')) set(true);
      else if (e.target.closest('[data-cz-close]')) set(false);
    });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && m.classList.contains('open')) set(false); });
  })();
</script>

{% schema %}
{
  "name": "Coszus header",
  "tag": "header",
  "class": "section-coszus-header",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo (cream, sits on the brown bar)", "info": "Falls back to the logo in Theme settings" },
    { "type": "checkbox", "id": "logo_invert", "label": "Turn a black logo cream on the brown bar", "default": true },
    { "type": "image_picker", "id": "logo_dark", "label": "Logo (black, for the mobile menu)" },
    { "type": "link_list", "id": "menu", "label": "Category menu", "default": "main-menu", "info": "Shown in the white bar and the mobile menu. Any link called Sale goes red." },
    { "type": "link_list", "id": "help_menu", "label": "Mobile menu small links", "info": "Our story, Shipping, Returns, Contact" },
    { "type": "header", "content": "Mobile menu promo card" },
    { "type": "image_picker", "id": "promo_image", "label": "Image" },
    { "type": "text", "id": "promo_kicker", "label": "Small heading", "default": "JOIN THE COMMUNITY" },
    { "type": "text", "id": "promo_title", "label": "Title", "default": "Black Friday early access" },
    { "type": "text", "id": "promo_text", "label": "Text", "default": "First look at drops, restocks and the sale." },
    { "type": "url", "id": "promo_url", "label": "Link" }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Scrolling message",
      "settings": [ { "type": "text", "id": "text", "label": "Text", "default": "Free UK shipping over £80" } ]
    }
  ],
  "max_blocks": 10,
  "enabled_on": { "groups": ["header"] },
  "presets": [ { "name": "Coszus header" } ]
}
{% endschema %}
