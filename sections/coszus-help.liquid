{%- comment -%}
  Coszus Help page (docs/HANDOFF.md sections 7 and 9). Side tabs: Contact us, Delivery, Returns,
  Size guide, FAQs. Replaces the PageFly help pages.

  Every tab is a block. Blocks that belong to a tab sit under it in the block list: Size table
  blocks under a Size guide tab, Question blocks under a FAQs tab (a section can't nest its own blocks).
  Each tab has an anchor, so /pages/help#delivery opens Delivery (footer and side menu links).
  With no JavaScript the tabs simply show one after another.

  Tables are plain text: one row per line, cells split by "|", first line is the header row.
{%- endcomment -%}

{%- liquid
  assign panel_types = 'contact,table_tab,text_tab,size_guide,faqs' | split: ','
-%}

<script
  src="{{ 'coszus-pages.js' | asset_url }}"
  type="module"
></script>
<noscript>
  <style>
    /* No JavaScript: every panel shows, spaced out */
    .coszus-tabs:not(.is-ready) .coszus-tabs__panel + .coszus-tabs__panel {
      display: block;
      margin-top: 48px;
    }
  </style>
</noscript>

<div class="coszus-page coszus-help">
  <h1 class="coszus-section-heading coszus-page__title">{{ section.settings.heading | escape }}</h1>

  <coszus-tabs class="coszus-tabs">
    <nav
      class="coszus-tabs__nav"
      aria-label="{{ section.settings.heading | escape }}"
    >
      {%- for block in section.blocks -%}
        {%- if panel_types contains block.type -%}
          {%- assign anchor = block.settings.anchor | default: block.settings.title | handleize -%}
          <a
            class="coszus-tabs__link"
            href="#{{ anchor }}"
            data-tab-link
          >
            {{- block.settings.title | escape -}}
          </a>
        {%- endif -%}
      {%- endfor -%}
    </nav>

    <div class="coszus-tabs__main">
      {%- for block in section.blocks -%}
        {%- unless panel_types contains block.type -%}
          {%- continue -%}
        {%- endunless -%}
        {%- liquid
          assign anchor = block.settings.anchor | default: block.settings.title | handleize
          assign start = forloop.index
        -%}
        <div
          class="coszus-tabs__panel"
          id="{{ anchor }}"
          tabindex="-1"
          data-tab-panel
          {{ block.shopify_attributes }}
        >
          <h2 class="coszus-section-heading coszus-help__heading">{{ block.settings.title | escape }}</h2>
          {%- if block.settings.intro != blank -%}
            <div class="coszus-page__sub coszus-help__rte">{{ block.settings.intro }}</div>
          {%- endif -%}

          {%- case block.type -%}
            {%- when 'contact' -%}
              <div class="coszus-help__cards">
                {%- if block.settings.email != blank -%}
                  <div class="coszus-box">
                    <b>{{ block.settings.email_label | escape }}</b>
                    <a href="mailto:{{ block.settings.email | strip }}">{{ block.settings.email | escape }}</a>
                  </div>
                {%- endif -%}
                {%- if block.settings.address != blank -%}
                  <div class="coszus-box">
                    <b>{{ block.settings.address_label | escape }}</b>
                    <p>{{ block.settings.address | escape | newline_to_br }}</p>
                  </div>
                {%- endif -%}
              </div>
              {%- if block.settings.show_form -%}
                {%- form 'contact', id: 'CoszusContactForm', class: 'coszus-form coszus-form--two' -%}
                  {%- if form.posted_successfully? -%}
                    <p
                      class="coszus-form__success"
                      role="status"
                    >
                      {{ block.settings.form_success | escape }}
                    </p>
                  {%- elsif form.errors -%}
                    <div
                      class="coszus-form__error"
                      role="alert"
                    >
                      {{ form.errors | default_errors }}
                    </div>
                  {%- endif -%}
                  <label>
                    {{- 'blocks.contact_form.name' | t -}}
                    <input
                      type="text"
                      name="contact[name]"
                      autocomplete="name"
                      value="{{ form.name | default: customer.name | escape }}"
                    >
                  </label>
                  <label>
                    {{- 'blocks.contact_form.email' | t -}}
                    <input
                      type="email"
                      name="contact[email]"
                      autocomplete="email"
                      required
                      value="{{ form.email | default: customer.email | escape }}"
                    >
                  </label>
                  <label>
                    {{- block.settings.order_label | escape -}}
                    <input
                      type="text"
                      name="contact[order_number]"
                    >
                  </label>
                  <label class="coszus-form__full">
                    {{- 'coszus.message' | t -}}
                    <textarea
                      name="contact[body]"
                      rows="4"
                      required
                    >{{ form.body | escape }}</textarea>
                  </label>
                  <button
                    type="submit"
                    class="button"
                  >
                    {{- block.settings.form_button | escape -}}
                  </button>
                {%- endform -%}
              {%- endif -%}

            {%- when 'table_tab' -%}
              {%- render 'coszus-table', table: block.settings.table -%}
              {%- if block.settings.after != blank -%}
                <div class="coszus-page__sub coszus-help__rte">{{ block.settings.after }}</div>
              {%- endif -%}

            {%- when 'text_tab' -%}
              {%- if block.settings.content != blank -%}
                <div class="coszus-help__rte coszus-help__content">{{ block.settings.content }}</div>
              {%- endif -%}
              {%- if block.settings.box_title != blank or block.settings.box_text != blank -%}
                <div class="coszus-box coszus-help__box">
                  {%- if block.settings.box_title != blank -%}
                    <b>{{ block.settings.box_title | escape }}</b>
                  {%- endif -%}
                  <p>{{ block.settings.box_text | escape | newline_to_br }}</p>
                </div>
              {%- endif -%}
              {%- if block.settings.button_label != blank and block.settings.button_link != blank -%}
                <a
                  class="button-secondary"
                  href="{{ block.settings.button_link }}"
                >
                  {{- block.settings.button_label | escape -}}
                </a>
              {%- endif -%}

            {%- when 'size_guide' -%}
              {%- liquid
                assign tables = 0
                for child in section.blocks offset: start
                  if panel_types contains child.type
                    break
                  endif
                  if child.type == 'size_table'
                    assign tables = tables | plus: 1
                  endif
                endfor
              -%}
              {%- if tables > 1 -%}
                <div
                  class="coszus-pills"
                  role="group"
                  aria-label="{{ block.settings.title | escape }}"
                >
                  {%- assign n = 0 -%}
                  {%- for child in section.blocks offset: start -%}
                    {%- if panel_types contains child.type -%}{%- break -%}{%- endif -%}
                    {%- if child.type == 'size_table' -%}
                      <button
                        type="button"
                        class="coszus-pills__button"
                        aria-pressed="{% if n == 0 %}true{% else %}false{% endif %}"
                        data-pill="{{ child.id }}"
                      >
                        {{- child.settings.label | escape -}}
                      </button>
                      {%- assign n = n | plus: 1 -%}
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              {%- endif -%}
              {%- assign n = 0 -%}
              {%- for child in section.blocks offset: start -%}
                {%- if panel_types contains child.type -%}{%- break -%}{%- endif -%}
                {%- if child.type == 'size_table' -%}
                  <div
                    class="coszus-help__size"
                    data-pill-panel="{{ child.id }}"
                    {% if n > 0 %}
                      data-pill-hidden
                    {% endif %}
                    {{ child.shopify_attributes }}
                  >
                    {%- if tables > 1 -%}
                      <h3 class="visually-hidden">{{ child.settings.label | escape }}</h3>
                    {%- endif -%}
                    {%- capture table_check -%}
                      {%- render 'coszus-table-check', table: child.settings.table -%}
                    {%- endcapture -%}
                    {%- comment -%} All dashes: no table. No measurements yet: the coming soon line. {%- endcomment -%}
                    {%- if table_check contains 'filled' -%}
                      {%- render 'coszus-table', table: child.settings.table -%}
                    {%- endif -%}
                    {%- unless table_check contains 'measured' -%}
                      {%- if block.settings.coming_soon != blank -%}
                        {%- capture contact_link %}<a href="/pages/help#contact">Message us</a>{% endcapture -%}
                        <p class="coszus-page__sub">{{ block.settings.coming_soon | escape | replace: 'Message us', contact_link }}</p>
                      {%- endif -%}
                    {%- endunless -%}
                  </div>
                  {%- assign n = n | plus: 1 -%}
                {%- endif -%}
              {%- endfor -%}
              {%- if block.settings.note != blank -%}
                <p class="coszus-note">{{ block.settings.note | escape }}</p>
              {%- endif -%}

            {%- when 'faqs' -%}
              <div class="coszus-help__faqs">
                {%- for child in section.blocks offset: start -%}
                  {%- if panel_types contains child.type -%}{%- break -%}{%- endif -%}
                  {%- if child.type == 'question' and child.settings.question != blank -%}
                    <details
                      class="coszus-help__faq"
                      {{ child.shopify_attributes }}
                    >
                      <summary>{{ child.settings.question | escape }}</summary>
                      <div class="coszus-help__rte">{{ child.settings.answer }}</div>
                    </details>
                  {%- endif -%}
                {%- endfor -%}
              </div>
          {%- endcase -%}
        </div>
      {%- endfor -%}
    </div>
  </coszus-tabs>
</div>

{% stylesheet %}
  .coszus-help__heading {
    margin-bottom: 12px;
  }

  .coszus-help__rte p {
    margin: 0 0 12px;
  }

  .coszus-help__rte a {
    color: var(--coszus-ink);
  }

  .coszus-help__content {
    margin-bottom: 22px;
    font-size: 0.875rem;
    line-height: 1.55;
  }

  .coszus-help__content ul {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .coszus-help__content li {
    position: relative;
    padding-left: 26px;
  }

  .coszus-help__content li::before {
    content: '\2713';
    position: absolute;
    left: 0;
    font-weight: 700;
  }

  .coszus-help__cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-bottom: 26px;
  }

  .coszus-help__box {
    margin-bottom: 16px;
  }

  .coszus-form {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .coszus-form--two {
    display: grid;
    grid-template-columns: 1fr 1fr;
    max-width: 640px;
  }

  .coszus-form--two > :is(.coszus-form__full, button, .coszus-form__success, .coszus-form__error) {
    grid-column: 1 / -1;
  }

  .coszus-form--two > button {
    justify-self: start;
  }

  .coszus-form label {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 0.75rem;
    font-weight: 600;
  }

  .coszus-form :is(input, textarea) {
    min-height: 46px;
    padding: 0 14px;
    border: 1px solid var(--coszus-line);
    border-radius: 6px;
    background: var(--coszus-paper);
    color: var(--coszus-ink);
    font: inherit;
    font-size: 0.875rem;
    font-weight: 400;
  }

  .coszus-form textarea {
    padding: 12px 14px;
    resize: vertical;
  }

  .coszus-form :is(input, textarea):focus {
    border-color: var(--coszus-ink);
  }

  .coszus-form__success {
    margin: 0;
    font-size: 0.875rem;
  }

  .coszus-form__error {
    font-size: 0.8125rem;
    color: var(--coszus-rouge);
  }

  .coszus-pills {
    display: inline-flex;
    gap: 4px;
    margin-bottom: 16px;
    padding: 3px;
    border-radius: 999px;
    background: var(--coszus-off-white);
  }

  .coszus-pills__button {
    position: relative;
    padding: 8px 14px;
    border: 0;
    border-radius: 999px;
    background: none;
    color: var(--coszus-ink);
    font: inherit;
    font-size: 0.75rem;
    font-weight: 600;
    cursor: pointer;
  }

  /* 44px tall hit area, centred on the pill, so the look doesn't change */
  .coszus-pills__button::after {
    content: '';
    position: absolute;
    inset: min(0px, 50% - 22px) 0;
  }

  .coszus-pills__button[aria-pressed='true'] {
    background: var(--coszus-ink);
    color: var(--coszus-paper);
  }

  .coszus-pills:has(button) ~ [data-pill-hidden] {
    display: none;
  }

  .coszus-help__faq {
    border-bottom: 1px solid var(--coszus-line);
  }

  .coszus-help__faq summary {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 0;
    font-size: 0.9375rem;
    font-weight: 500;
    list-style: none;
    cursor: pointer;
  }

  .coszus-help__faq summary::-webkit-details-marker {
    display: none;
  }

  .coszus-help__faq summary::after {
    content: '+';
    font-weight: 300;
  }

  .coszus-help__faq[open] summary::after {
    content: '\2212';
  }

  .coszus-help__faq .coszus-help__rte {
    padding-bottom: 4px;
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--coszus-muted);
  }

  @media screen and (max-width: 820px) {
    .coszus-help__cards,
    .coszus-form--two {
      grid-template-columns: minmax(0, 1fr);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Coszus help",
  "tag": "section",
  "class": "coszus-help-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Help"
    },
    {
      "type": "paragraph",
      "content": "Each tab is a block. Size table blocks belong to the Size guide tab above them, Question blocks to the FAQs tab above them. Link to a tab with its anchor, e.g. /pages/help#delivery."
    }
  ],
  "blocks": [
    {
      "type": "contact",
      "name": "Contact tab",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Contact us"
        },
        {
          "type": "text",
          "id": "anchor",
          "label": "Anchor",
          "default": "contact"
        },
        {
          "type": "richtext",
          "id": "intro",
          "label": "Intro",
          "default": "<p>We're here Monday to Friday, 9am to 5pm UK time.</p>"
        },
        {
          "type": "text",
          "id": "email_label",
          "label": "Email label",
          "default": "Email"
        },
        {
          "type": "text",
          "id": "email",
          "label": "Email",
          "default": "info@coszus.com"
        },
        {
          "type": "text",
          "id": "address_label",
          "label": "Address label",
          "default": "Post"
        },
        {
          "type": "textarea",
          "id": "address",
          "label": "Address",
          "default": "Coszus, J & S House, Denton Drive, Northwich, CW9 7LU"
        },
        {
          "type": "checkbox",
          "id": "show_form",
