{%- assign ml = linklists[section.settings.menu] -%}
<section class="cz cz-help">
  <div class="cz-help-t">
    <div class="cz-kick">{{ section.settings.kicker }}</div>
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.text }}</p>
    <div class="cz-help-l">{%- for link in ml.links -%}<a href="{{ link.url }}">{{ link.title }}</a>{%- endfor -%}</div>
  </div>
  <a class="cz-help-i" href="{{ section.settings.url | default: '#' }}">
    {%- render 'coszus-img', image: section.settings.image, asset: section.settings.image_asset, width: 1600, alt: '', sizes: '(min-width: 901px) 50vw, 100vw' -%}
    <span class="cz-help-c"><span class="cz-k">{{ section.settings.i_kicker }}</span><span class="cz-t">{{ section.settings.i_title }}</span>{%- if section.settings.i_button != blank -%}<span class="cz-btn">{{ section.settings.i_button }}</span>{%- endif -%}</span>
  </a>
</section>
{% schema %}
{
  "name": "Coszus help + lookbook",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Small heading", "default": "CUSTOMER SUPPORT" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "HOW CAN WE HELP?" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Questions on sizing, delivery or an order? Message us and you'll get a real reply from the team." },
    { "type": "link_list", "id": "menu", "label": "Help links", "info": "Shipping, Returns & exchange, Size guide, Contact" },
    { "type": "header", "content": "Lookbook image" },
    { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "text", "id": "image_asset", "label": "Or theme image file", "info": "Used when no image is picked above" },
    { "type": "text", "id": "i_kicker", "label": "Small heading", "default": "NOT SURE HOW TO STYLE IT?" },
    { "type": "text", "id": "i_title", "label": "Title", "default": "SEE THE LOOKBOOK" },
    { "type": "text", "id": "i_button", "label": "Button", "default": "Show me" },
    { "type": "url", "id": "url", "label": "Link" }
  ],
  "presets": [ { "name": "Coszus help + lookbook" } ]
}
{% endschema %}
