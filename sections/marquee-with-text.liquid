{% comment %}
  Section: Marquee / Moving text bar (Studio theme compatible)
  - Full-bleed: no page-width container, stretches edge to edge
  - Seamless scroll using two identical groups (no gap)
  - Each group repeats content 3× to ensure no empty tails on wide screens
  - Per-item icons: choose a built-in SVG or upload a custom image (image overrides icon)
{% endcomment %}

<section id="marquee-{{ section.id }}" class="section color-{{ section.settings.color_scheme }}">
  <style>
    /* ---- Section chrome ---- */
    #marquee-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
      {% if section.settings.show_borders %}
        border-top: 1px solid rgba(0,0,0,.08);
        border-bottom: 1px solid rgba(0,0,0,.08);
      {% endif %}
    }

    /* ---- Marquee core ---- */
    #marquee-{{ section.id }} .marquee {
      overflow: hidden;
      width: 100%;
      --duration: {{ section.settings.speed_seconds }}s;
      --gap: {{ section.settings.gap }}rem;
    }

    /* Moving rail holds exactly two groups of equal width */
    #marquee-{{ section.id }} .marquee__rail {
      display: flex;
      width: max-content;
      will-change: transform;
      animation: marquee-scroll var(--duration) linear infinite;
      -webkit-backface-visibility: hidden;
      backface-visibility: hidden;
    }

    /* Pause on hover (optional) */
    {% if section.settings.pause_on_hover %}
      #marquee-{{ section.id }} .marquee:hover .marquee__rail { animation-play-state: paused; }
    {% endif %}

    /* Direction toggle */
    {% if section.settings.direction == 'right' %}
      #marquee-{{ section.id }} .marquee__rail { animation-name: marquee-scroll-right; }
    {% endif %}

    /* Each group: flush-left start */
    #marquee-{{ section.id }} .marquee__group {
      display: inline-flex;
      gap: var(--gap);
      flex-shrink: 0;
      white-space: nowrap;
      align-items: center;
      justify-content: flex-start;
      font-size: {{ section.settings.font_size }}px;
      letter-spacing: calc({{ section.settings.letter_spacing_pct }} / 100 * 1em);
      text-transform: {% if section.settings.uppercase %}uppercase{% else %}none{% endif %};
    }

    /* Items + separators */
    #marquee-{{ section.id }} .marquee__item { display: inline-flex; align-items: center; }
    #marquee-{{ section.id }} .marquee__sep  { opacity: .45; padding: 0 .6rem; }

    /* Icon styles */
    #marquee-{{ section.id }} .marquee__icon {
      display: inline-block;
      margin-right: 0.4rem;
      vertical-align: middle;
    }
    #marquee-{{ section.id }} .marquee__icon svg { display: block; }

    /* Seamless loop */
    @keyframes marquee-scroll       { from { transform: translate3d(0,0,0); } to { transform: translate3d(-50%,0,0); } }
    @keyframes marquee-scroll-right { from { transform: translate3d(-50%,0,0);} to { transform: translate3d(0,0,0); } }

    /* Reduced motion */
    @media (prefers-reduced-motion: reduce) {
      #marquee-{{ section.id }} .marquee__rail { animation: none; transform: none; }
    }
  </style>

  <div class="marquee" aria-label="{{ section.settings.aria_label | escape }}">
    {% capture marquee_items %}
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          <span class="marquee__item" {{ block.shopify_attributes }}>
            {% assign size = block.settings.icon_size | default: 16 %}
            {% if block.settings.icon_image != blank %}
              <img class="marquee__icon"
                   src="{{ block.settings.icon_image | image_url: width: 2 | replace: 'width=2', 'width=' | append: size }}"
                   alt=""
                   width="{{ size }}" height="{{ size }}" loading="lazy">
            {% elsif block.settings.icon_name != 'none' %}
              <span class="marquee__icon" style="width:{{ size }}px;height:{{ size }}px;">
                {% case block.settings.icon_name %}
                  {% when 'truck' %}
                    <svg viewBox="0 0 24 24" width="{{ size }}" height="{{ size }}" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7z"/><circle cx="7.5" cy="18" r="1.5"/><circle cx="17.5" cy="18" r="1.5"/></svg>
                  {% when 'refresh' %}
                    <svg viewBox="0 0 24 24" width="{{ size }}" height="{{ size }}" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9A9 9 0 0 1 21 8"/><path d="M20.49 15A9 9 0 0 1 3 16"/></svg>
                  {% when 'lock' %}
                    <svg viewBox="0 0 24 24" width="{{ size }}" height="{{ size }}" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="10" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                  {% when 'star' %}
                    <svg viewBox="0 0 24 24" width="{{ size }}" height="{{ size }}" fill="currentColor"><path d="M12 2l3.09 6.26 6.91.99-5 4.88 1.18 6.87L12 17.77 5.82 21l1.18-6.87-5-4.88 6.91-.99z"/></svg>
                  {% when 'tag' %}
                    <svg viewBox="0 0 24 24" width="{{ size }}" height="{{ size }}" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41L11 3H4v7l9.59 9.59a2 2 0 0 0 2.82 0l4.18-4.18a2 2 0 0 0 0-2.82z"/><circle cx="7.5" cy="7.5" r="1.5"/></svg>
                  {% when 'globe' %}
                    <svg viewBox="0 0 24 24" width="{{ size }}" height="{{ size }}" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 0 20"/><path d="M12 2a15.3 15.3 0 0 0 0 20"/></svg>
                  {% when 'leaf' %}
                    <svg viewBox="0 0 24 24" width="{{ size }}" height="{{ size }}" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M11 3C7 3 3 7 3 11c0 6 6 10 11 10 4 0 7-3 7-7 0-7-5-11-10-11z"/><path d="M12 22C12 12 7 7 2 7"/></svg>
                  {% when 'sparkles' %}
                    <svg viewBox="0 0 24 24" width="{{ size }}" height="{{ size }}" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 3l2 4 4 2-4 2-2 4-2-4-4-2 4-2z"/><path d="M19 11l1 2 2 1-2 1-1 2-1-2-2-1 2-1z"/><path d="M13 5l1 2 2 1-2 1-1 2-1-2-2-1 2-1z"/></svg>
                  {% when 'tshirt' %}
                    <svg viewBox="0 0 24 24" width="{{ size }}" height="{{ size }}" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M16 3l5 3-3 4v9H6V10L3 6l5-3a5 5 0 0 0 8 0z"/></svg>
                  {% when 'lightning' %}
                    <svg viewBox="0 0 24 24" width="{{ size }}" height="{{ size }}" fill="currentColor"><path d="M11 21l1-7H8l7-11-1 7h4l-7 11z"/></svg>
                  {% when 'shield' %}
                    <svg viewBox="0 0 24 24" width="{{ size }}" height="{{ size }}" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                  {% when 'gift' %}
                    <svg viewBox="0 0 24 24" width="{{ size }}" height="{{ size }}" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="8" width="18" height="13" rx="2"/><path d="M3 12h18"/><path d="M12 8v13"/><path d="M12 8s-3-1-3-3 3-3 3 1 0 2 0 2zM12 8s3-1 3-3-3-3-3 1 0 2 0 2z"/></svg>
                {% endcase %}
              </span>
            {% endif %}
            {{ block.settings.text }}
          </span>
          {% unless forloop.last %}
            <span class="marquee__sep">{{ section.settings.separator }}</span>
          {% endunless %}
        {% endfor %}
      {% else %}
        <span class="marquee__item">FREE 24H SHIPPING ON ORDERS £80+</span>
        <span class="marquee__sep">{{ section.settings.separator | default: "•" }}</span>
        <span class="marquee__item">NEW DROP LIVE NOW</span>
        <span class="marquee__sep">{{ section.settings.separator | default: "•" }}</span>
        <span class="marquee__item">COSZUS — PREMIUM ESSENTIALS</span>
      {% endif %}
    {% endcapture %}

    <div class="marquee__rail">
      <div class="marquee__group">
        {{ marquee_items }}{{ marquee_items }}{{ marquee_items }}
      </div>
      <div class="marquee__group" aria-hidden="true">
        {{ marquee_items }}{{ marquee_items }}{{ marquee_items }}
      </div>
    </div>
  </div>

  {% schema %}
  {
    "name": "Marquee (moving text bar)",
    "settings": [
      { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "background-1" },
      { "type": "text", "id": "aria_label", "label": "Accessibility label", "default": "Scrolling announcements" },
      { "type": "text", "id": "separator", "label": "Separator between items", "default": "•" },
      { "type": "range", "id": "speed_seconds", "label": "Scroll duration (slower ←→ faster)", "min": 6, "max": 60, "step": 1, "unit": "s", "default": 22 },
      { "type": "range", "id": "gap", "label": "Gap between items", "min": 0.5, "max": 6, "step": 0.5, "default": 2.5 },
      { "type": "select", "id": "direction", "label": "Direction", "default": "left", "options": [ { "value": "left", "label": "Left" }, { "value": "right", "label": "Right" } ] },
      { "type": "checkbox", "id": "pause_on_hover", "label": "Pause on hover", "default": true },
      { "type": "checkbox", "id": "uppercase", "label": "Uppercase text", "default": true },
      { "type": "range", "id": "font_size", "label": "Font size", "min": 10, "max": 28, "step": 1, "unit": "px", "default": 14 },
      { "type": "range", "id": "letter_spacing_pct", "label": "Letter spacing (percent of 1em)", "min": 0, "max": 20, "step": 1, "unit": "%", "default": 8 },
      { "type": "checkbox", "id": "show_borders", "label": "Show top & bottom borders", "default": true },
      { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 60, "step": 2, "unit": "px", "default": 10 },
      { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 60, "step": 2, "unit": "px", "default": 10 }
    ],
    "blocks": [
      {
        "type": "item",
        "name": "Text item",
        "settings": [
          { "type": "select", "id": "icon_name", "label": "Built-in icon", "default": "none",
            "options": [
              { "value": "none", "label": "None" },
              { "value": "truck", "label": "Truck (shipping)" },
              { "value": "refresh", "label": "Refresh (returns)" },
              { "value": "lock", "label": "Lock (secure)" },
              { "value": "star", "label": "Star" },
              { "value": "tag", "label": "Tag (deal)" },
              { "value": "globe", "label": "Globe" },
              { "value": "leaf", "label": "Leaf" },
              { "value": "sparkles", "label": "Sparkles" },
              { "value": "tshirt", "label": "T-shirt" },
              { "value": "lightning", "label": "Lightning" },
              { "value": "shield", "label": "Shield" },
              { "value": "gift", "label": "Gift" }
            ]
          },
          { "type": "image_picker", "id": "icon_image", "label": "Or upload custom icon (overrides built-in)" },
          { "type": "range", "id": "icon_size", "label": "Icon size", "min": 12, "max": 28, "step": 1, "unit": "px", "default": 16 },
          { "type": "text", "id": "text", "label": "Text", "default": "FREE 24H SHIPPING ON ORDERS £80+" }
        ]
      }
    ],
    "presets": [
      {
        "name": "Marquee (moving text bar)",
        "category": "Text",
        "blocks": [ { "type": "item" }, { "type": "item" }, { "type": "item" } ]
      }
    ]
  }
  {% endschema %}
</section>