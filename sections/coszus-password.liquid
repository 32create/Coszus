{%- comment -%}
  Coszus locked-site page (shown while the store is password protected).
  Email sign-up to get the code (tagged for Klaviyo), and a box to enter the code.
{%- endcomment -%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600;700&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet">
{{ 'coszus.css' | asset_url | stylesheet_tag }}
<script src="{{ 'coszus.js' | asset_url }}" defer="defer"></script>
<style>
  body.password{background:#12241B !important}
  .password-main{min-height:100vh}
  .main-password-footer,.password-main~footer{display:none}
  .cz-lock{position:relative;min-height:100vh;display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,1fr);background:var(--cz-dark);color:var(--cz-cream);font-family:var(--cz-font)}
  .cz-lock-t{display:flex;flex-direction:column;justify-content:center;gap:22px;padding:clamp(40px,7vw,104px) var(--cz-g)}
  .cz-lock-logo{width:200px;height:64px;object-fit:cover;filter:brightness(0) invert(.94) sepia(.12);margin-left:-8px}
  .cz-lock h1{margin:0;font-size:clamp(48px,7vw,96px);line-height:.92;font-weight:700;letter-spacing:-.01em;color:var(--cz-cream)}
  .cz-lock p{margin:0;max-width:460px;font-size:15px;line-height:1.55;color:#E8DCCD}
  .cz-lock-step{display:flex;flex-direction:column;gap:10px;max-width:480px}
  .cz-lock-step small{font-size:10px;font-weight:600;letter-spacing:.2em;color:var(--cz-sand)}
  .cz-lock form{display:flex;gap:8px;flex-wrap:wrap}
  .cz-lock input[type=email],.cz-lock input[type=password]{flex:1 1 220px;height:50px;padding:0 2px;border:0;border-bottom:1px solid rgba(243,234,223,.45);border-radius:0;background:transparent;color:var(--cz-cream);font:inherit;font-size:14px;outline:none;box-shadow:none}
  .cz-lock input::placeholder{color:rgba(243,234,223,.6)}
  .cz-lock button{height:50px;padding:0 22px;border:0;border-radius:var(--cz-r);background:var(--cz-cream);color:var(--cz-dark);font:inherit;font-size:10.5px;font-weight:700;letter-spacing:.16em;cursor:pointer}
  .cz-lock button.ghost{background:transparent;color:var(--cz-cream);box-shadow:inset 0 0 0 1px rgba(243,234,223,.5)}
  .cz-lock-msg{flex-basis:100%;font-size:13px;font-weight:600}
  .cz-lock-msg.err{color:#f1b3ae;font-weight:500}
  .cz-lock-i{position:relative;overflow:hidden;background:#1a3126}
  .cz-lock-i img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:{{ section.settings.focal }}}
  .cz-lock-div{height:1px;background:rgba(243,234,223,.15);max-width:480px}
  .cz-lock-offer{font-size:clamp(34px,4.6vw,64px);line-height:.95;font-weight:700;letter-spacing:-.02em;text-transform:uppercase;color:var(--cz-cream);margin-top:-6px}
  .cz-lock-calb{display:flex;gap:8px;flex-wrap:wrap}
  .cz-lock-cbtn{display:inline-flex;align-items:center;height:44px;padding:0 18px;border-radius:var(--cz-r);box-shadow:inset 0 0 0 1px rgba(243,234,223,.5);color:var(--cz-cream);text-decoration:none;font-size:10.5px;font-weight:700;letter-spacing:.16em}
  .cz-lock-cbtn:hover{background:var(--cz-cream);color:var(--cz-dark)}
  @media (max-width:900px){.cz-lock{grid-template-columns:1fr}.cz-lock-i{height:340px;order:-1}.cz-lock-t{padding:36px 20px 56px}}
</style>

<div class="cz-lock">
  <div class="cz-lock-t">
    {%- assign logo = section.settings.logo | default: settings.logo -%}
    {%- if logo != blank -%}{{ logo | image_url: width: 500 | image_tag: alt: shop.name, class: 'cz-lock-logo' }}{%- else -%}<span style="font-size:22px;font-weight:700;letter-spacing:.24em;">{{ shop.name | upcase }}</span>{%- endif -%}
    <div class="cz-bfk">{{ section.settings.kicker }}</div>
    <h1>{{ section.settings.heading | newline_to_br }}</h1>
    {%- if section.settings.offer != blank -%}<div class="cz-lock-offer">{{ section.settings.offer }}</div>{%- endif -%}
    <p>{{ section.settings.text }}</p>
    {%- if section.settings.ends != blank -%}
      <div class="cz-cd" role="timer" data-cz-cd="{{ section.settings.ends }}"><div><b data-d>00</b><span>DAYS</span></div><div><b data-h>00</b><span>HRS</span></div><div><b data-m>00</b><span>MINS</span></div><div><b data-s>00</b><span>SECS</span></div></div>
    {%- endif -%}

    <div class="cz-lock-step">
      <small>1. GET YOUR CODE</small>
      {%- form 'customer', id: 'CzLockJoin' -%}
        <input type="hidden" name="contact[tags]" value="newsletter,{{ section.settings.tag }}">
        {%- if form.posted_successfully? -%}
          <div class="cz-lock-msg" role="status">{{ section.settings.success }}</div>
        {%- else -%}
          <label for="CzLockEmail" class="cz-vh">Email</label>
          <input id="CzLockEmail" type="email" name="contact[email]" required placeholder="Email address" autocomplete="email">
          <button type="submit">{{ section.settings.join_button }}</button>
          {%- if form.errors -%}<div class="cz-lock-msg err" role="alert">Check your email address and try again.</div>{%- endif -%}
        {%- endif -%}
      {%- endform -%}
    </div>

    <div class="cz-lock-div"></div>

    <div class="cz-lock-step">
      <small>2. GOT THE CODE? GET IN</small>
      {%- form 'storefront_password', id: 'CzLockPass' -%}
        <label for="CzLockCode" class="cz-vh">Early access code</label>
        <input id="CzLockCode" type="password" name="password" required placeholder="Enter your code" autocomplete="off">
        <button type="submit" class="ghost">ENTER</button>
        {%- if form.errors -%}<div class="cz-lock-msg err" role="alert">That code isn't right. Check your email and try again.</div>{%- endif -%}
      {%- endform -%}
    </div>

    {%- if section.settings.cal_show -%}
      {%- assign cal_t = section.settings.cal_title | default: 'Coszus Black Friday early access' -%}
      {%- assign cal_d = section.settings.cal_details | default: 'Early access opens. Use your code to get in.' -%}
      {%- capture cal_u -%}https://{{ shop.domain }}{%- endcapture -%}
      <div class="cz-lock-div"></div>
      <div class="cz-lock-step cz-lock-cal">
        <small>DON'T MISS IT</small>
        <div class="cz-lock-calb">
          <a class="cz-lock-cbtn" target="_blank" rel="noopener" href="https://calendar.google.com/calendar/render?action=TEMPLATE&text={{ cal_t | url_encode }}&dates={{ section.settings.cal_start }}/{{ section.settings.cal_end }}&details={{ cal_d | url_encode }}%20{{ cal_u | url_encode }}&location={{ cal_u | url_encode }}">GOOGLE CALENDAR</a>
          <a class="cz-lock-cbtn" href="#" data-cz-ics data-t="{{ cal_t | escape }}" data-d="{{ cal_d | escape }}" data-u="{{ cal_u }}" data-s="{{ section.settings.cal_start }}" data-e="{{ section.settings.cal_end }}">APPLE / OUTLOOK</a>
        </div>
      </div>
      <script>
        document.querySelectorAll('[data-cz-ics]').forEach(function(a){
          var d=a.dataset, ics=['BEGIN:VCALENDAR','VERSION:2.0','PRODID:-//Coszus//EN','BEGIN:VEVENT','UID:cz-bf-'+d.s+'@coszus','DTSTAMP:'+d.s,'DTSTART:'+d.s,'DTEND:'+d.e,'SUMMARY:'+d.t,'DESCRIPTION:'+d.d+' '+d.u,'URL:'+d.u,'LOCATION:'+d.u,'BEGIN:VALARM','TRIGGER:-PT30M','ACTION:DISPLAY','DESCRIPTION:'+d.t,'END:VALARM','END:VEVENT','END:VCALENDAR'].join('\r\n');
          a.href='data:text/calendar;charset=utf-8,'+encodeURIComponent(ics); a.setAttribute('download','coszus-black-friday.ics');
        });
      </script>
    {%- endif -%}
  </div>
  <div class="cz-lock-i">
    {%- render 'coszus-img', image: section.settings.image, asset: section.settings.image_asset, width: 1600, alt: '', loading: 'eager', sizes: '(min-width: 901px) 50vw, 100vw' -%}
  </div>
</div>

{% schema %}
{
  "name": "Coszus locked site",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo", "info": "A black logo is turned cream automatically" },
    { "type": "text", "id": "kicker", "label": "Small heading", "default": "EARLY ACCESS · SUNDAY 22 NOVEMBER, 6:30PM" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "BLACK\nFRIDAY" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "The site's locked for the community only. Pop your email in, we'll send you the code, and you're in before anyone else." },
    { "type": "text", "id": "offer", "label": "Big offer line", "default": "Up to 70% off" },
    { "type": "text", "id": "ends", "label": "Count down to", "info": "UK time in winter = Z, like 2026-11-22T18:30:00Z", "default": "2026-11-22T18:30:00Z" },
    { "type": "text", "id": "join_button", "label": "Sign-up button", "default": "SEND ME THE CODE" },
    { "type": "text", "id": "success", "label": "Message after sign-up", "default": "You're on the list. Your code's on its way before we open." },
    { "type": "text", "id": "tag", "label": "Customer tag for sign-ups", "default": "bf-early-access", "info": "Build the Klaviyo flow that sends the code from this tag" },
    { "type": "checkbox", "id": "cal_show", "label": "Show add to calendar", "default": true },
    { "type": "text", "id": "cal_title", "label": "Calendar event name", "default": "Coszus Black Friday early access" },
    { "type": "text", "id": "cal_details", "label": "Calendar event details", "default": "Early access opens. Use your code to get in." },
    { "type": "text", "id": "cal_start", "label": "Calendar start (UTC)", "default": "20261122T183000Z", "info": "Format 20261122T183000Z" },
    { "type": "text", "id": "cal_end", "label": "Calendar end (UTC)", "default": "20261122T200000Z" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "image_asset", "label": "Or theme image file", "default": "cz-puffer-dark-portrait.jpg" },
    { "type": "text", "id": "focal", "label": "Image focus (CSS object-position)", "default": "center 30%" }
  ]
}
{% endschema %}
