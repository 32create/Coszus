<section class="cz cz-looks">
  <h2 class="cz-h2">{{ section.settings.heading }}</h2>
  <div class="cz-grid5">
    {%- for block in section.blocks -%}
      <a href="{{ block.settings.url | default: '#' }}" class="cz-look" {{ block.shopify_attributes }}>
        <div class="cz-fig">{%- if block.settings.image != blank -%}{{ block.settings.image | image_url: width: 700 | image_tag: alt: block.settings.label, loading: 'lazy' }}{%- endif -%}</div>
        <div class="cz-look-l">{{ block.settings.label }}</div>
      </a>
    {%- endfor -%}
  </div>
</section>
{% schema %}
{
  "name": "Coszus shop the look",
  "settings": [ { "type": "text", "id": "heading", "label": "Heading", "default": "SHOP THE LOOK" } ],
  "max_blocks": 6,
  "blocks": [ { "type": "look", "name": "Look", "settings": [
    { "type": "image_picker", "id": "image", "label": "Flat lay outfit (cut out)" },
    { "type": "text", "id": "label", "label": "Label", "default": "GREY ZIP HOODIE" },
    { "type": "url", "id": "url", "label": "Link" }
  ]}],
  "presets": [ { "name": "Coszus shop the look", "blocks": [ { "type": "look" }, { "type": "look" }, { "type": "look" }, { "type": "look" }, { "type": "look" } ] } ]
}
{% endschema %}
