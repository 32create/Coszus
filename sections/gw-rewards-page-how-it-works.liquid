{% stylesheet %}
  .gw-rpl-how-it-works {
    margin: 40px auto;
    max-width: 1600px;
    box-sizing: border-box;
  }

  .gw-rpl-how-it-works__container {
    max-width: 1118px;
    margin: 0 auto;
  }

  .gw-rpl-how-it-works__title {
    padding-top: 37px;
    font-size: clamp(24px, 9px + 3vw, 32px);
    line-height: 40px;
    font-weight: 700;
    text-align: center;
  }

  .gw-rpl-how-it-works__cards {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    justify-items: center;
    grid-template-columns: repeat(auto-fit, minmax(288px, 270px));
    justify-content: center;
    gap: 20px;
  }

  .gw-rpl-how-it-works__card-item {
    border: 2px solid #EBEEF5;
    border-radius: 16px;
    padding: 40px 24px;
    width: 100%;
  }

  .gw-rpl-how-it-works__card-item:nth-child(2) {
    background-color: #ebeced;
    border: 1px solid #F3F3F3;
  }

  .gw-rpl-how-it-works__card-icon {
    display: flex;
    justify-content: center;
  }

  .gw-rpl-how-it-works__card-title {
    font-size: 20px;
    font-weight: 700;
    line-height: 28px;
    text-align: center;
    color: #323B4B;
    margin: 15px 0 0;
  }

  .gw-rpl-how-it-works__card-text {
    font-size: 16px;
    line-height: 24px;
    font-weight: 400;
    text-align: center;
    margin: 15px 0 0;
  }

  @media screen and (max-width: 800px) {
    .gw-rpl-how-it-works__title {
      padding-top: 36px;
    }
  }
{% endstylesheet %}




