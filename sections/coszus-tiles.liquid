<section class="cz cz-tiles">
  {%- for block in section.blocks -%}
    <a class="cz-tile" href="{{ block.settings.url | default: '#' }}" {{ block.shopify_attributes }}>
      {%- render 'coszus-img', image: block.settings.image, asset: block.settings.image_asset, width: 1200, alt: block.settings.label, sizes: '(min-width: 901px) 33vw, 100vw' -%}
      <span>{{ block.settings.label }}</span>
    </a>
  {%- endfor -%}
</section>
{% schema %}
{
  "name": "Coszus category tiles",
  "max_blocks": 4,
  "blocks": [ { "type": "tile", "name": "Tile", "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "text", "id": "image_asset", "label": "Or theme image file", "info": "Used when no image is picked above" },
    { "type": "text", "id": "label", "label": "Label", "default": "HOODIES" },
    { "type": "url", "id": "url", "label": "Link" }
  ]}],
  "presets": [ { "name": "Coszus category tiles", "blocks": [ { "type": "tile", "settings": { "label": "CAPS" } }, { "type": "tile", "settings": { "label": "HOODIES" } }, { "type": "tile", "settings": { "label": "POLOS" } } ] } ]
}
{% endschema %}
