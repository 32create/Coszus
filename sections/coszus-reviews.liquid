{%- if section.blocks.size > 0 -%}
<section class="cz cz-revs" id="reviews">
  <div class="cz-kick" style="color:var(--cz-brown);">{{ section.settings.kicker }}</div>
  {%- if section.settings.heading != blank -%}<div class="cz-revs-h"><span aria-hidden="true">★★★★★</span> {{ section.settings.heading }}</div>{%- endif -%}
  <div class="cz-revs-g">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when '@app' -%}<div style="grid-column:1/-1;">{% render block %}</div>
        {%- when 'review' -%}<div class="cz-rev" {{ block.shopify_attributes }}><div class="cz-rev-s" aria-hidden="true">★★★★★</div><div>{{ block.settings.text }}</div><div class="cz-rev-n">{{ block.settings.name }}</div></div>
      {%- endcase -%}
    {%- endfor -%}
  </div>
</section>
{%- endif -%}
{% schema %}
{
  "name": "Coszus reviews",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Small heading", "default": "REVIEWS" },
    { "type": "text", "id": "heading", "label": "Rating line", "default": "Rated 4.9 by our customers" }
  ],
  "blocks": [
    { "type": "@app" },
    { "type": "review", "name": "Review", "settings": [ { "type": "richtext", "id": "text", "label": "Review" }, { "type": "text", "id": "name", "label": "Name", "default": "Verified buyer" } ] }
  ],
  "presets": [ { "name": "Coszus reviews", "blocks": [ { "type": "review" }, { "type": "review" }, { "type": "review" } ] } ]
}
{% endschema %}
