{%- comment -%}
  Coszus shop cards (docs/HANDOFF.md section 4.2). A "Shop" heading, then three cards under the hero:
  a photo with a plain text label underneath (Men / Women / Juniors). Each card is one link. Three
  across on desktop; on phones a swipe row showing about 1.3 cards so the next one peeks in.
  Each card is a block: photo, label and link. A card with no photo shows neutral grey.
  The photos are below the hero, so they're always lazy: the hero's first slide stays the LCP image.
{%- endcomment -%}

{%- liquid
  assign heading_id = 'CoszusShopCardsHeading-' | append: section.id
  assign ratio = '1 / 1'
  if section.settings.image_shape == 'portrait'
    assign ratio = '4 / 5'
  endif
-%}

<div
  class="coszus-shop-cards"
  style="
    --shop-cards-padding-top: {{ section.settings.padding_top }}px;
    --shop-cards-padding-bottom: {{ section.settings.padding_bottom }}px;
    --shop-cards-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --shop-cards-ratio: {{ ratio }};
  "
>
  {%- if section.settings.heading != blank -%}
    <h2
      id="{{ heading_id }}"
      class="coszus-section-heading coszus-shop-cards__heading"
    >
      {{ section.settings.heading | escape }}
    </h2>
  {%- endif -%}

  {%- if section.blocks.size > 0 -%}
    <ul
      class="coszus-shop-cards__list"
      role="list"
      {% if section.settings.heading != blank %}
        aria-labelledby="{{ heading_id }}"
      {% else %}
        aria-label="{{ section.settings.label | escape }}"
      {% endif %}
    >
      {%- for block in section.blocks -%}
        {%- liquid
          assign link = block.settings.link | default: routes.all_products_collection_url
          assign image = block.settings.image
          # The label names the link; without one the photo's alt has to
          assign alt = ''
          if block.settings.label == blank
            assign alt = image.alt
          endif
        -%}
        <li
          class="coszus-shop-cards__card"
          {{ block.shopify_attributes }}
        >
          <a
            class="coszus-shop-cards__link"
            href="{{ link }}"
          >
            <span class="coszus-shop-cards__media">
              {%- if image != blank -%}
                {{-
                  image
                  | image_url: width: 1200
                  | image_tag:
                    widths: '300, 400, 500, 600, 800, 1000, 1200',
                    sizes: '(min-width: 821px) calc((100vw - 72px) / 3), calc(77vw - 37px)',
                    loading: 'lazy',
                    alt: alt,
                    class: 'coszus-shop-cards__image'
                -}}
              {%- endif -%}
            </span>
            {%- if block.settings.label != blank -%}
              <span class="coszus-shop-cards__label">{{ block.settings.label | escape }}</span>
            {%- endif -%}
          </a>
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}
</div>

{% stylesheet %}
  .coszus-shop-cards {
    padding-block: var(--shop-cards-padding-top) var(--shop-cards-padding-bottom);
    background: var(--coszus-paper);
    color: var(--coszus-ink);
  }

  .coszus-shop-cards__heading {
    margin-bottom: 28px;
    padding-inline: var(--coszus-gutter);
    line-height: 1;
  }

  /* Three across on desktop, same 12px gap as the product grid */
  .coszus-shop-cards__list {
    --shop-cards-gap: 12px;

    display: flex;
    gap: var(--shop-cards-gap);
    margin: 0;
    padding: 0 var(--coszus-gutter);
    list-style: none;
  }

  .coszus-shop-cards__card {
    flex: 0 0 calc((100% - 2 * var(--shop-cards-gap)) / 3);
    min-width: 0;
  }

  .coszus-shop-cards__link {
    display: flex;
    flex-direction: column;
    gap: 12px;
    color: inherit;
    text-decoration: none;
  }

  .coszus-shop-cards__link:focus-visible {
    outline: 2px solid currentcolor;
    outline-offset: 3px;
  }

  /* Neutral grey until a photo is picked, and behind the photo while it loads */
  .coszus-shop-cards__media {
    position: relative;
    display: block;
    aspect-ratio: var(--shop-cards-ratio, 1 / 1);
    overflow: hidden;
    background: #e4e4e2;
  }

  .coszus-shop-cards__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--coszus-motion) ease;
  }

  .coszus-shop-cards__label {
    font-size: 0.875rem;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: 0.04em;
    text-align: start;
    text-transform: uppercase;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
    transition: text-decoration-color var(--coszus-motion-fast) ease;
  }

  @media (hover: hover) {
    .coszus-shop-cards__link:hover .coszus-shop-cards__image {
      transform: scale(1.03);
    }

    .coszus-shop-cards__link:hover .coszus-shop-cards__label {
      text-decoration-color: currentcolor;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .coszus-shop-cards__image {
      transition: none;
    }
  }

  /* Phones: a swipe row, about 1.3 cards in view so the next one peeks in */
  @media screen and (max-width: 820px) {
    .coszus-shop-cards {
      padding-bottom: var(--shop-cards-padding-bottom-mobile);
    }

    .coszus-shop-cards__heading {
      margin-bottom: 20px;
    }

    .coszus-shop-cards__list {
      --shop-cards-gap: 8px;

      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--coszus-gutter);
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }

    .coszus-shop-cards__list::-webkit-scrollbar {
      display: none;
    }

    .coszus-shop-cards__card {
      flex-basis: calc((100% - var(--shop-cards-gap)) / 1.3);
      scroll-snap-align: start;
    }

    .coszus-shop-cards__link {
      gap: 10px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Coszus shop cards",
  "tag": "section",
  "class": "coszus-shop-cards-section",
  "max_blocks": 3,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop",
      "info": "Leave blank to hide."
    },
    {
      "type": "select",
      "id": "image_shape",
      "label": "Image shape",
      "options": [
        {
          "value": "square",
          "label": "Square (1:1)"
        },
        {
          "value": "portrait",
          "label": "Portrait (4:5)"
        }
      ],
      "default": "square"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Name for screen readers",
      "default": "Shop by department",
      "info": "Only used when the heading is blank."
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding on phones",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 24
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Shop card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "At least 1000px wide. Cropped from the centre to the section's image shape. Shows grey until one is picked."
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Men"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "The whole card (photo and label) goes here."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Coszus shop cards",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "label": "Men"
          }
        },
        {
          "type": "card",
          "settings": {
            "label": "Women"
          }
        },
        {
          "type": "card",
          "settings": {
            "label": "Juniors"
          }
        }
      ]
    }
  ]
}
{% endschema %}
