{%- comment -%}
  Coszus Latest News (docs/HANDOFF.md section 4.5). The big split "LATEST ... NEWS" heading across
  the full width (the one exception to the section heading style), three cards (video or image,
  title, category, one line, link), and a "See all latest news" button (hidden on mobile, where the
  cards swipe). Each card is a block; pick a blog post to fill it, or write it by hand. A card with
  no title (nothing written and no post, or its post was deleted) or no image or video isn't shown, and the button is
  hidden while the blog it points to has no posts.
  Card videos play muted while on screen, and not at all for reduced motion.
{%- endcomment -%}

<script
  src="{{ 'coszus-home.js' | asset_url }}"
  type="module"
></script>

<coszus-news
  class="coszus-news"
  style="
    --news-padding-top: {{ section.settings.padding_top }}px;
    --news-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <h2 class="coszus-news__heading">
    <span>{{ section.settings.heading_start | escape }}</span>
    {%- if section.settings.heading_end != blank %}
      <span>{{ section.settings.heading_end | escape }}</span>
    {%- endif -%}
  </h2>

  <div
    class="coszus-news__grid"
    role="list"
  >
    {%- for block in section.blocks -%}
      {%- liquid
        assign article = block.settings.article
        assign title = block.settings.title | default: article.title
        assign image = block.settings.image | default: article.image
        assign link = block.settings.link | default: article.url
        # Links off the site (e.g. YouTube) open in a new tab
        assign link_attrs = ''
        if link contains '://'
          assign link_attrs = ' target="_blank" rel="noopener"'
        endif
        assign tag = block.settings.tag | default: article.tags.first
        assign text = block.settings.text
        if text == blank and article != blank
          assign text = article.excerpt_or_content | strip_html | truncatewords: 16
        endif
        assign video = block.settings.video
        assign poster = image | default: video.preview_image
      -%}
      {%- if title == blank -%}
        {%- continue -%}
      {%- endif -%}
      {%- comment -%} No image, video or post image: hidden on the live site, placeholder in the editor {%- endcomment -%}
      {%- if poster == blank and request.design_mode == false -%}
        {%- continue -%}
      {%- endif -%}
      <article
        class="coszus-news__card"
        role="listitem"
        {{ block.shopify_attributes }}
      >
        <a
          class="coszus-news__media"
          href="{{ link | default: '#' }}"{{ link_attrs }}
          data-news-media
          tabindex="-1"
          aria-hidden="true"
        >
          {%- if poster != blank -%}
            {{-
              poster
              | image_url: width: 1400
              | image_tag:
                widths: '400, 600, 800, 1000, 1400',
                sizes: '(min-width: 821px) calc((100vw - 104px) / 3), calc(74vw - 30px)',
                loading: 'lazy',
                alt: '',
                class: 'coszus-news__image'
            -}}
          {%- else -%}
            {{- 'lifestyle-2' | placeholder_svg_tag: 'coszus-news__image coszus-news__placeholder' -}}
          {%- endif -%}
          {%- if video != blank -%}
            {%- render 'coszus-video', video: video, class: 'coszus-news__video', max_width: 1080, loop: true -%}
          {%- endif -%}
        </a>
        <div class="coszus-news__body">
          <div class="coszus-news__row">
            <h3 class="coszus-news__title">
              {%- if link != blank -%}
                <a href="{{ link }}"{{ link_attrs }}>{{ title | escape }}</a>
              {%- else -%}
                {{ title | escape }}
              {%- endif -%}
            </h3>
            {%- if tag != blank -%}
              <span class="coszus-news__tag">{{ tag | escape }}</span>
            {%- endif -%}
          </div>
          {%- if text != blank -%}
            <p class="coszus-news__text">{{ text | escape }}</p>
          {%- endif -%}
          {%- if block.settings.link_label != blank and link != blank -%}
            <a
              class="coszus-news__more"
              href="{{ link }}"{{ link_attrs }}
              aria-label="{{ block.settings.link_label | escape }}: {{ title | escape }}"
            >
              {{- block.settings.link_label | escape -}}
            </a>
          {%- endif -%}
        </div>
      </article>
    {%- endfor -%}
  </div>

  {%- liquid
    # A button to a blog with no posts leads to an empty page, so it waits for the first post
    assign show_button = false
    if section.settings.button_label != blank
      assign show_button = true
    endif
    assign button_link = section.settings.button_link | default: '/blogs'
    if button_link contains '/blogs/'
      assign blog_handle = button_link | split: '/blogs/' | last | split: '/' | first | split: '?' | first
      if blogs[blog_handle].articles_count == 0
        assign show_button = false
      endif
    endif
  -%}
  {%- if show_button -%}
    <div class="coszus-news__foot">
      <a
        class="button"
        href="{{ section.settings.button_link | default: '/blogs' }}"
      >
        {{- section.settings.button_label | escape -}}
      </a>
    </div>
  {%- endif -%}
</coszus-news>

{% stylesheet %}
  .coszus-news {
    display: block;
    padding: var(--news-padding-top) var(--coszus-gutter) var(--news-padding-bottom);
    background: var(--coszus-paper);
    color: var(--coszus-ink);
  }

  .coszus-news__heading {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 20px;
    margin: 0 0 32px;
    font-family: var(--font-heading--family);
    font-weight: 700;
    font-size: clamp(40px, 5vw, 72px);
    line-height: 1;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .coszus-news__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px;
  }

  .coszus-news__media {
    position: relative;
    display: block;
    aspect-ratio: 469 / 366;
    overflow: hidden;
    background: var(--coszus-off-white);
  }

  .coszus-news__image,
  .coszus-news__video {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .coszus-news__image {
    transition: transform calc(var(--coszus-motion) * 2) var(--coszus-ease);
  }

  .coszus-news__placeholder {
    fill: var(--coszus-concrete);
    opacity: 0.4;
  }

  .coszus-news__video {
    opacity: 0;
    transition: opacity var(--coszus-motion) ease;
  }

  .coszus-news__media.is-playing .coszus-news__video {
    opacity: 1;
  }

  @media (hover: hover) {
    .coszus-news__card:hover .coszus-news__image {
      transform: scale(1.03);
    }
  }

  .coszus-news__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    padding-top: 18px;
  }

  .coszus-news__row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    width: 100%;
  }

  .coszus-news__title {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: 0.875rem;
    font-weight: 700;
    line-height: 18px;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .coszus-news__title a {
    color: inherit;
    text-decoration: none;
  }

  .coszus-news__tag {
    flex: none;
    color: var(--coszus-muted);
    font-size: var(--coszus-kicker-size);
    line-height: 18px;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .coszus-news__text {
    max-width: 40ch;
    margin: 0;
    color: var(--coszus-muted);
    font-size: 0.8125rem;
    line-height: 19px;
  }

  .coszus-news__more {
    margin-top: 4px;
    color: var(--coszus-ink);
    font-size: 0.75rem;
    line-height: 18px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .coszus-news__more:hover,
  .coszus-news__title a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .coszus-news__foot {
    display: flex;
    justify-content: center;
    margin-top: 40px;
  }

  .coszus-news__foot .button {
    margin: 0;
  }

  @media screen and (max-width: 820px) {
    .coszus-news {
      padding-inline: 0;
      padding-top: min(var(--news-padding-top), 36px);
      padding-bottom: min(var(--news-padding-bottom), 28px);
    }

    .coszus-news__heading {
      margin-bottom: 16px;
      padding-inline: var(--coszus-gutter);
      font-size: 30px;
    }

    .coszus-news__grid {
      display: flex;
      gap: 14px;
      padding-inline: var(--coszus-gutter);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--coszus-gutter);
      scrollbar-width: none;
    }

    .coszus-news__grid::-webkit-scrollbar {
      display: none;
    }

    .coszus-news__card {
      flex: 0 0 74%;
      min-width: 0;
      scroll-snap-align: start;
    }

    .coszus-news__media {
      aspect-ratio: 4 / 3;
    }

    .coszus-news__body {
      gap: 6px;
      padding-top: 10px;
    }

    .coszus-news__text {
      font-size: 0.75rem;
      line-height: 17px;
    }

    .coszus-news__foot {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Coszus latest news",
  "tag": "section",
  "class": "coszus-news-section",
  "max_blocks": 3,
  "settings": [
    {
      "type": "text",
      "id": "heading_start",
      "label": "Heading, left",
      "default": "Latest"
    },
    {
      "type": "text",
      "id": "heading_end",
      "label": "Heading, right",
      "default": "News"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "info": "Hidden on mobile.",
      "default": "See all latest news"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "article",
          "id": "article",
          "label": "Blog post",
          "info": "Optional. Fills the title, image, line and link. Anything below overrides it."
        },
        {
          "type": "video",
          "id": "video",
          "label": "Video",
          "info": "Plays muted on a loop while on screen."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Also the video's poster."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Category",
          "info": "e.g. Drop, Founder, Community"
        },
        {
          "type": "text",
          "id": "text",
          "label": "One line"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label",
          "default": "Read more"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Coszus latest news",
      "blocks": [
        {
          "type": "card"
        },
        {
          "type": "card"
        },
        {
          "type": "card"
        }
      ]
    }
  ]
}
{% endschema %}
