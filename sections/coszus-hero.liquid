{%- comment -%} Coszus homepage hero carousel: Black Friday countdown slide + split image slides. {%- endcomment -%}
<section class="cz cz-hs" id="CzHs-{{ section.id }}" aria-label="Featured" aria-roledescription="carousel">
  <div class="cz-hsc" data-cz-hsc>
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'countdown' -%}
          {%- assign live_url = block.settings.live_url | default: settings.bf_collection.url | default: block.settings.url -%}
          <a class="cz-sl cz-bfs" href="{{ block.settings.url | default: '#' }}" data-live-href="{{ live_url }}" {{ block.shopify_attributes }} aria-label="{{ block.settings.heading | strip_html | escape }}, slide {{ forloop.index }} of {{ forloop.length }}">
            {%- render 'coszus-img', image: block.settings.image, asset: block.settings.image_asset, width: 2400, alt: '', loading: 'eager', sizes: '100vw' -%}
            <span class="cz-bfc">
              <span class="cz-bfk" data-bf-off>{{ block.settings.kicker }}</span>
              <span class="cz-bfk" data-bf-on>{{ block.settings.live_kicker }}</span>
              <span class="cz-bfh">{{ block.settings.heading | newline_to_br }}</span>
              <span class="cz-bfp" data-bf-off>{{ block.settings.text }}</span>
              <span class="cz-bfp" data-bf-on>{{ block.settings.live_text }}</span>
              {%- if block.settings.ends != blank -%}
                <span class="cz-cdn" role="timer" data-bf-off data-cz-cd="{{ block.settings.ends }}"><span><b data-d>00</b>DAYS</span><span><b data-h>00</b>HRS</span><span><b data-m>00</b>MINS</span><span><b data-s>00</b>SECS</span></span>
              {%- endif -%}
              {%- if block.settings.button != blank -%}<span class="cz-bfb" data-bf-off>{{ block.settings.button }}</span>{%- endif -%}
              {%- if block.settings.live_button != blank -%}<span class="cz-bfb" data-bf-on>{{ block.settings.live_button }}</span>{%- endif -%}
            </span>
          </a>
        {%- when 'split' -%}
          <div class="cz-sl cz-split" {{ block.shopify_attributes }}>
            {%- for i in (1..2) -%}
              {%- liquid
                assign img_key = 'image_' | append: i
                assign k_key = 'kicker_' | append: i
                assign t_key = 'title_' | append: i
                assign b_key = 'button_' | append: i
                assign u_key = 'url_' | append: i
                assign a_key = 'asset_' | append: i
              -%}
              <a class="cz-half" href="{{ block.settings[u_key] | default: '#' }}">
                {%- render 'coszus-img', image: block.settings[img_key], asset: block.settings[a_key], width: 1400, alt: block.settings[t_key], sizes: '50vw' -%}
                <span class="cz-cap"><span class="cz-k">{{ block.settings[k_key] }}</span><span class="cz-t">{{ block.settings[t_key] }}</span>{%- if block.settings[b_key] != blank -%}<span class="cz-btn">{{ block.settings[b_key] }}</span>{%- endif -%}</span>
              </a>
            {%- endfor -%}
          </div>
      {%- endcase -%}
    {%- endfor -%}
  </div>
  {%- if section.blocks.size > 1 -%}
    <button type="button" class="cz-harr prev" data-cz-hprev aria-label="Previous slide"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M10 3L5 8l5 5"/></svg></button>
    <button type="button" class="cz-harr next" data-cz-hnext aria-label="Next slide"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M6 3l5 5-5 5"/></svg></button>
    <div class="cz-hdots">{%- for block in section.blocks -%}<button type="button" data-cz-hgo="{{ forloop.index0 }}" aria-label="Slide {{ forloop.index }}"{% if forloop.first %} aria-current="true"{% endif %}><span></span></button>{%- endfor -%}</div>
  {%- endif -%}
</section>
<script>
(function () {
  var r = document.getElementById('CzHs-{{ section.id }}'); if (!r) return;
  var sc = r.querySelector('[data-cz-hsc]'), n = sc.children.length;
  function at() { return Math.round(sc.scrollLeft / sc.clientWidth); }
  function go(i) { i = (i + n) % n; sc.scrollTo({ left: i * sc.clientWidth, behavior: 'smooth' }); }
  function sync() { var i = at(); r.querySelectorAll('[data-cz-hgo]').forEach(function (b, j) { b.setAttribute('aria-current', i === j ? 'true' : 'false'); }); var p = r.querySelector('[data-cz-hprev]'), x = r.querySelector('[data-cz-hnext]'); if (p) p.hidden = i === 0; if (x) x.hidden = i === n - 1; }
  sc.addEventListener('scroll', function () { clearTimeout(sc._t); sc._t = setTimeout(sync, 60); }, { passive: true });
  if (document.documentElement.getAttribute('data-bf') === 'live') r.querySelectorAll('[data-live-href]').forEach(function (a) { if (a.dataset.liveHref) a.href = a.dataset.liveHref; });
  r.addEventListener('click', function (e) { var b; if (e.target.closest('[data-cz-hnext]')) go(at() + 1); else if (e.target.closest('[data-cz-hprev]')) go(at() - 1); else if ((b = e.target.closest('[data-cz-hgo]'))) go(Number(b.dataset.czHgo)); });
  sync();
})();
</script>
{% schema %}
{
  "name": "Coszus hero",
  "settings": [],
  "blocks": [
    { "type": "countdown", "name": "Countdown slide", "settings": [
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "text", "id": "image_asset", "label": "Or theme image file", "info": "Used when no image is picked above" },
      { "type": "text", "id": "kicker", "label": "Small heading", "default": "STARTS FRIDAY 27 NOVEMBER" },
      { "type": "textarea", "id": "heading", "label": "Heading", "default": "BLACK\nFRIDAY" },
      { "type": "text", "id": "text", "label": "Text", "default": "Up to 30% off. The community gets in first, so sign up for early access." },
      { "type": "text", "id": "ends", "label": "Count down to", "info": "UK time, like 2026-11-27T00:00:00Z. Leave blank to hide the clock.", "default": "2026-11-27T00:00:00Z" },
      { "type": "text", "id": "button", "label": "Button", "default": "GET EARLY ACCESS" },
      { "type": "url", "id": "url", "label": "Link" },
      { "type": "header", "content": "Once Black Friday is live" },
      { "type": "text", "id": "live_kicker", "label": "Small heading", "default": "NOW ON · NEW COLLECTION INCLUDED" },
      { "type": "text", "id": "live_text", "label": "Text", "default": "Up to 70% off, and the new collection drops straight into the sale." },
      { "type": "text", "id": "live_button", "label": "Button", "default": "SHOP BLACK FRIDAY" },
      { "type": "url", "id": "live_url", "label": "Link", "info": "Defaults to the Black Friday collection in Theme settings" }
    ]},
    { "type": "split", "name": "Two image slide", "settings": [
      { "type": "header", "content": "Left" },
      { "type": "image_picker", "id": "image_1", "label": "Image" },
      { "type": "text", "id": "asset_1", "label": "Or theme image file", "info": "Used when no image is picked above" },
      { "type": "text", "id": "kicker_1", "label": "Small heading", "default": "BACK IN STOCK" },
      { "type": "text", "id": "title_1", "label": "Title", "default": "ALL STAR CAP" },
      { "type": "text", "id": "button_1", "label": "Button", "default": "Shop caps" },
      { "type": "url", "id": "url_1", "label": "Link" },
      { "type": "header", "content": "Right" },
      { "type": "image_picker", "id": "image_2", "label": "Image" },
      { "type": "text", "id": "asset_2", "label": "Or theme image file", "info": "Used when no image is picked above" },
      { "type": "text", "id": "kicker_2", "label": "Small heading", "default": "NEW IN" },
      { "type": "text", "id": "title_2", "label": "Title", "default": "EMBROIDERED ZIP HOODIE" },
      { "type": "text", "id": "button_2", "label": "Button", "default": "Shop hoodies" },
      { "type": "url", "id": "url_2", "label": "Link" }
    ]}
  ],
  "presets": [ { "name": "Coszus hero", "blocks": [ { "type": "countdown" }, { "type": "split" } ] } ]
}
{% endschema %}
