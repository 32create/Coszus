{%- comment -%}
  Coszus campaign banner (docs/HANDOFF.md section 4.6). Full width, copy and button bottom right;
  on mobile a square crop with the copy centred at the bottom. A dark shade behind the copy on both.
{%- endcomment -%}

{%- liquid
  assign image = section.settings.image
  assign mobile_image = section.settings.mobile_image
  assign link = section.settings.link | default: routes.all_products_collection_url
  # Alt text: the image's own alt from Files, else the banner heading (a11y and SEO both want one)
  assign alt = image.alt | default: section.settings.heading | default: section.settings.kicker | strip_newlines
-%}

<div
  class="coszus-banner"
  style="
    {%- if mobile_image != blank %}--banner-position-mobile: {{ mobile_image.presentation.focal_point }};{% endif -%}
    --banner-ratio: {{ section.settings.ratio }};
  "
>
  {%- if image != blank -%}
    <picture>
      {%- if mobile_image != blank -%}
        <source
          media="(max-width: 820px)"
          srcset="
            {%- for width in (1..4) -%}
              {%- assign w = width | times: 400 -%}
              {{ mobile_image | image_url: width: w }} {{ w }}w{% unless forloop.last %}, {% endunless %}
            {%- endfor -%}
          "
          sizes="100vw"
        >
      {%- endif -%}
      {{-
        image
        | image_url: width: 3000
        | image_tag:
          widths: '600, 900, 1200, 1600, 2000, 2400, 3000',
          sizes: '100vw',
          loading: 'lazy',
          alt: alt,
          class: 'coszus-banner__image'
      -}}
    </picture>
  {%- else -%}
    {{- 'lifestyle-2' | placeholder_svg_tag: 'coszus-banner__image coszus-banner__placeholder' -}}
  {%- endif -%}

  <div class="coszus-banner__copy">
    {%- if section.settings.kicker != blank -%}
      <p class="coszus-banner__kicker">{{ section.settings.kicker | escape }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="coszus-banner__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a
        class="button-secondary coszus-banner__button"
        href="{{ link }}"
      >
        {{- section.settings.button_label | escape -}}
      </a>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .coszus-banner {
    position: relative;
    width: 100%;
    aspect-ratio: var(--banner-ratio, 2576 / 1010);
    overflow: hidden;
    background: var(--coszus-ink);
    color: #fff;
  }

  .coszus-banner picture {
    position: absolute;
    inset: 0;
  }

  .coszus-banner__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .coszus-banner__placeholder {
    background: #2a2a2a;
    fill: rgb(255 255 255 / 0.25);
  }

  /* A dark shade up from the bottom, behind the heading and button, so the copy never sits on the
     bare photo */
  .coszus-banner::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    z-index: 1;
    height: 50%;
    background: linear-gradient(to bottom, rgb(16 16 16 / 0), rgb(16 16 16 / 0.6));
    pointer-events: none;
  }

  .coszus-banner__copy {
    position: absolute;
    right: 6.2%;
    bottom: 6.1%;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    text-align: right;
  }

  .coszus-banner__kicker {
    margin: 0;
    font-family: var(--font-system--family);
    font-weight: 500;
    /* 11px floor: HANDOFF labels and kickers are 11px */
    font-size: clamp(11px, 0.82vw, 12px);
    letter-spacing: 0.14em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .coszus-banner__heading {
    margin: clamp(14px, 1.6vw, 22px) 0 clamp(16px, 1.9vw, 26px);
    color: inherit;
    font-family: var(--font-heading--family);
    font-weight: 700;
    font-size: clamp(20px, 1.95vw, 27px);
    line-height: 1;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }

  .coszus-banner__button {
    margin: 0;
  }

  @media screen and (max-width: 820px) {
    .coszus-banner {
      aspect-ratio: 1 / 1;
    }

    .coszus-banner__image {
      object-position: var(--banner-position-mobile, 28% center);
    }

    .coszus-banner::after {
      height: 55%;
    }

    .coszus-banner__copy {
      left: var(--coszus-gutter);
      right: var(--coszus-gutter);
      bottom: 28px;
      align-items: center;
      text-align: center;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Coszus campaign banner",
  "tag": "section",
  "class": "coszus-banner-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Wide, at least 2400px. Set a focal point so the square mobile crop works."
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image",
      "info": "Optional. Square."
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Desktop shape",
      "options": [
        {
          "value": "2576 / 1010",
          "label": "Wide (design)"
        },
        {
          "value": "16 / 9",
          "label": "16:9"
        },
        {
          "value": "2 / 1",
          "label": "2:1"
        }
      ],
      "default": "2576 / 1010"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "New Wave - Web exclusives"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Tracksuits now in"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    }
  ],
  "presets": [
    {
      "name": "Coszus campaign banner"
    }
  ]
}
{% endschema %}
