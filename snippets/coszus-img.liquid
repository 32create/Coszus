{%- comment -%}
  Picture from the image picker, or a theme asset file name as a fallback.
  render 'coszus-img', image: block.settings.image, asset: block.settings.image_asset, width: 1600, alt: '', loading: 'lazy', sizes: '50vw', class: ''
{%- endcomment -%}
{%- liquid
  assign w = width | default: 1600
  assign load = loading | default: 'lazy'
  assign sz = sizes | default: '100vw'
-%}
{%- if image != blank -%}
  {{ image | image_url: width: w | image_tag: alt: alt, loading: load, sizes: sz, widths: '600,900,1200,1600,2000', class: class }}
{%- elsif asset != blank -%}
  {%- assign half = w | divided_by: 2 -%}
  <img src="{{ asset | asset_img_url: '1600x' }}" srcset="{{ asset | asset_img_url: '800x' }} 800w, {{ asset | asset_img_url: '1600x' }} 1600w, {{ asset | asset_img_url: '2400x' }} 2400w" sizes="{{ sz }}" alt="{{ alt | escape }}" loading="{{ load }}"{% if class != blank %} class="{{ class }}"{% endif %} width="{{ w }}" height="{{ half }}">
{%- endif -%}
