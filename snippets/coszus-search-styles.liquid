{%- doc -%}
  Coszus restyle of Horizon's search modal and predictive search (docs/HANDOFF.md section 3,
  docs/design/01-homepage.html): a panel that drops from the top, a big search line, the Shop /
  Popular / Recent empty state, then instant results 6 across on desktop and a list on mobile.
  Horizon's markup and behaviour are untouched. Scoped to #search-modal.

  @example
  {% render 'coszus-search-styles' %}
{%- enddoc -%}

{% stylesheet %}
  /* ---------- Panel: full width, drops from the top ---------- */
  #search-modal {
    --coszus-search-gutter: 24px;
    --coszus-search-line: #efefef;
  }

  #search-modal .search-modal__content {
    inset: 0 0 auto;
    width: 100%;
    max-width: 100%;
    height: auto;
    max-height: 90dvh;
    margin: 0;
    padding: 0;
    border: none;
    border-radius: 0;
    box-shadow: 0 20px 50px rgb(0 0 0 / 0.12);
    background: var(--coszus-paper);
    color: var(--coszus-ink);
    font-family: var(--font-body--family);
    overflow: hidden;
  }

  #search-modal .search-modal__content::backdrop {
    display: block;
    background: rgb(16 16 16 / 0.4);
    backdrop-filter: none;
  }

  :root #search-modal .dialog-modal[open].search-modal__content {
    border-radius: 0;
    box-shadow: 0 20px 50px rgb(0 0 0 / 0.12);
    transform-origin: top center;
    animation: coszus-search-drop calc(var(--coszus-motion) + 0.05s) var(--coszus-ease) both;
  }

  :root #search-modal .dialog-modal.search-modal__content.dialog-closing {
    animation: coszus-search-lift var(--coszus-motion-fast) ease forwards;
  }

  @keyframes coszus-search-drop {
    from {
      transform: translateY(-102%);
    }
  }

  @keyframes coszus-search-lift {
    to {
      transform: translateY(-102%);
    }
  }

  #search-modal predictive-search-component {
    display: block;
    background: none;
  }

  #search-modal .predictive-search-form {
    display: flex;
    flex-direction: column;
    max-height: 90dvh;
  }

  /* ---------- Search line ---------- */
  #search-modal .predictive-search-form__header {
    position: relative;
    width: auto;
    gap: 14px;
    margin: 0 var(--coszus-search-gutter);
    padding: 30px 0 18px;
    border: none;
    border-bottom: 1px solid var(--coszus-ink);
    border-radius: 0;
    background: none;
  }

  /* Horizon forces a grey border on focus with !important; the design keeps the Ink line */
  :root #search-modal .predictive-search-form__header {
    border-color: transparent transparent var(--coszus-ink) !important;
  }

  #search-modal .predictive-search-form__header::before {
    content: none;
  }

  #search-modal .predictive-search-form__header-inner {
    flex: 1;
    min-width: 0;
    width: auto;
    position: relative;
    border: none;
    border-radius: 0;
    background: none;
    outline: none;
  }

  #search-modal input.search-input {
    padding: 0 0 0 36px;
    font-family: var(--font-body--family);
    font-size: clamp(24px, 2.6vw, 36px);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--coszus-ink);
  }

  #search-modal input.search-input::placeholder {
    color: var(--coszus-concrete);
    opacity: 1;
    transition: opacity 0.3s ease;
  }

  #search-modal input.search-input.coszus-search-input--fading::placeholder {
    opacity: 0;
  }

  #search-modal input.search-input::-webkit-search-cancel-button {
    display: none;
  }

  #search-modal .predictive-search__icon {
    inset-inline-start: 0;
    width: 22px;
    height: 22px;
    color: var(--coszus-ink);
  }

  #search-modal .predictive-search__icon > svg {
    width: 22px;
    height: 22px;
  }

  #search-modal .predictive-search__reset-button {
    min-width: auto;
    margin: 0 0 0 8px;
    padding: 0 4px;
    font-size: 12px;
    color: var(--coszus-muted);
    opacity: 1;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  #search-modal .predictive-search__close-modal-button {
    flex: none;
    margin: 0;
  }

  #search-modal .predictive-search__close-modal-button .svg-wrapper,
  #search-modal .predictive-search__close-modal-button svg {
    width: 18px;
    height: 18px;
  }

  /* ---------- Body ---------- */
  #search-modal .predictive-search-form__content-wrapper {
    position: relative;
    top: auto;
    flex: 1;
    min-height: 0;
    max-height: none;
    border-radius: 0;
    box-shadow: none;
    overflow: hidden;
  }

  #search-modal .predictive-search-form__content {
    max-height: calc(90dvh - 90px);
    background: none;
  }

  #search-modal .predictive-search-results__inner {
    padding: 30px var(--coszus-search-gutter) 40px;
    overflow: visible;
  }

  .coszus-search__kicker,
  #search-modal .predictive-search-results__title {
    margin: 0 0 12px;
    font-family: var(--font-body--family);
    font-size: var(--coszus-kicker-size, 11px);
    font-weight: 500;
    letter-spacing: var(--coszus-kicker-tracking, 0.16em);
    line-height: 1.4;
    text-transform: uppercase;
    color: var(--coszus-muted);
  }

  /* Empty state: big Shop links, Popular and Recent */
  .coszus-search-idle {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 240px;
    gap: 40px;
    max-width: 900px;
  }

  .coszus-search-idle__shop {
    margin: 0;
    padding: 0;
  }

  .coszus-search-idle__shop-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 0;
    border-bottom: 1px solid var(--coszus-search-line);
    font-size: clamp(24px, 2.4vw, 32px);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.15;
    color: var(--coszus-ink);
    text-decoration: none;
    transition: padding var(--coszus-motion-fast) var(--coszus-ease);
  }

  .coszus-search-idle__shop-link--sale {
    color: var(--coszus-rouge);
  }

  .coszus-search-idle__arrow {
    font-size: 20px;
    font-weight: 300;
    opacity: 0;
    transform: translateX(-8px);
    transition: opacity var(--coszus-motion-fast) ease, transform var(--coszus-motion-fast) ease;
  }

  @media (hover: hover) {
    .coszus-search-idle__shop-link:hover {
      padding-inline-start: 6px;
    }

    .coszus-search-idle__shop-link:hover .coszus-search-idle__arrow {
      opacity: 1;
      transform: none;
    }
  }

  .coszus-search-idle__shop-link:focus-visible .coszus-search-idle__arrow {
    opacity: 1;
    transform: none;
  }

  .coszus-search-idle__terms {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
    margin: 0;
    padding: 0;
  }

  .coszus-search-idle__terms a {
    display: inline-block;
    padding: 5px 0;
    font-size: 14px;
    color: var(--coszus-ink);
    text-decoration: none;
  }

  /* Touch on the desktop layout (iPad landscape): the term list spaced to 44px rows.
     Phones show the terms as pills instead (below). */
  @media screen and (min-width: 821px) and (pointer: coarse) {
    .coszus-search-idle__terms {
      gap: 0;
      margin-block: -6px;
    }

    .coszus-search-idle__terms a {
      padding-block: 0;
      line-height: 44px;
    }
  }

  .coszus-search-idle__terms a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .coszus-search-recent {
    display: block;
    margin-top: 24px;
  }

  .coszus-search-recent[hidden] {
    display: none;
  }

  .coszus-search-recent__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }

  .coszus-search-recent__clear {
    position: relative;
    overflow: visible;
    font-size: 12px;
    color: var(--coszus-muted);
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }

  /* 44px hit areas, centred, so Clear and the pills look the same */
  .coszus-search-recent__clear::before,
  #search-modal .predictive-search-results__pill::before,
  .coszus-search-pills .pills__pill::before {
    content: '';
    position: absolute;
    inset: min(0px, 50% - 22px) -8px;
  }

  #search-modal .predictive-search-results__pill::before,
  .coszus-search-pills .pills__pill::before {
    inset-inline: 0;
  }

  /* ---------- Results ---------- */
  #search-modal .predictive-search-results__wrapper-queries {
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 26px;
    padding: 0;
    overflow: visible;
  }

  #search-modal .predictive-search-results__card--query {
    width: auto;
    padding: 0;
    border: none;
  }

  #search-modal .predictive-search-results__pill,
  .coszus-search-pills .pills__pill {
    position: relative;
    padding: 7px 13px;
    border: 1px solid var(--coszus-line);
    border-radius: 999px;
    background: var(--coszus-paper);
    font-size: 12.5px;
    color: var(--coszus-ink);
    text-decoration: none;
  }

  #search-modal .predictive-search-results__pill:hover,
  .coszus-search-pills .pills__pill:hover {
    border-color: var(--coszus-ink);
  }

  #search-modal .predictive-search-results__pill mark {
    background: none;
    color: inherit;
    font-weight: 700;
  }

  .coszus-search-note {
    margin: 0 0 14px;
    font-size: 13px;
    color: var(--coszus-muted);
  }

  .coszus-search-note b {
    color: var(--coszus-ink);
  }

  #search-modal .predictive-search-results__no-results {
    margin: 0 0 12px;
    font-size: 15px;
    font-weight: 600;
    text-align: start;
    color: var(--coszus-ink);
  }

  #search-modal .coszus-search-shop-links {
    margin: 0 0 22px;
  }

  /* Wrapped rows 8px apart so the pills' 44px hit areas don't overlap */
  .coszus-search-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 6px;
    margin: 0 0 26px;
    padding: 0;
  }

  #search-modal :is(.predictive-search-results__products, .predictive-search-results__wrapper-products, .recently-viewed-wrapper) {
    padding-inline: 0;
    margin-inline: 0;
  }

  /* Instant results: 6 across */
  #search-modal .predictive-search-results__wrapper-products {
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 10px;
  }

  #search-modal .predictive-search-results__card--product,
  #search-modal .predictive-search-results__card--product:hover,
  #search-modal .predictive-search-results__card--product:is([aria-selected='true'].keyboard-focus, :focus-visible, :has(.resource-card:focus-visible)) {
    margin: 0;
    padding: 0;
    border-radius: 2px;
    background: none;
  }

  #search-modal .predictive-search-results__card--product:is([aria-selected='true'].keyboard-focus) {
    outline: 2px solid var(--coszus-ink);
    outline-offset: 2px;
  }

  #search-modal .predictive-search-results__card .resource-card__media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    border-radius: 2px;
    background: var(--coszus-off-white);
  }

  #search-modal .predictive-search-results__card .resource-card__image {
    mix-blend-mode: multiply;
  }

  #search-modal .predictive-search-results__card .resource-card__content {
    padding: 8px 2px 0;
    gap: 2px;
  }

  #search-modal .predictive-search-results__card .resource-card__title {
    display: -webkit-box;
    overflow: hidden;
    font-size: 12px;
    font-weight: 400;
    line-height: 1.3;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  /* Horizon's `.paragraph > *` would size the mark on its own */
  #search-modal .predictive-search-results__card .resource-card__title mark {
    background: none;
    color: var(--coszus-ink);
    font: inherit;
    font-weight: 700;
  }

  #search-modal .predictive-search-results__card :is(.price, product-price) {
    font-size: 12px;
    color: var(--coszus-muted);
  }

  #search-modal .predictive-search-results__card .compare-at-price {
    color: var(--coszus-muted);
  }

  /* "View all" */
  #search-modal .predictive-search-form__footer {
    padding: 12px var(--coszus-search-gutter) 18px;
    background: linear-gradient(to top, var(--coszus-paper) 60%, transparent);
  }

  #search-modal .predictive-search__search-button,
  #search-modal .predictive-search__search-button:hover {
    transform: none;
    box-shadow: none;
  }

  @media screen and (max-width: 1000px) and (min-width: 821px) {
    #search-modal .predictive-search-results__wrapper-products {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  /* ---------- Mobile: full screen, list results ---------- */
  @media screen and (max-width: 820px) {
    #search-modal {
      --coszus-search-gutter: 16px;
    }

    #search-modal .search-modal__content {
      height: 100dvh;
      max-height: 100dvh;
      padding: var(--safe-area-inset-top) var(--safe-area-inset-right) 0 var(--safe-area-inset-left);
    }

    #search-modal .predictive-search-form {
      height: 100%;
      max-height: none;
    }

    #search-modal .predictive-search-form__header {
      padding: 18px 0 12px;
    }

    #search-modal input.search-input {
      padding-inline-start: 32px;
      font-size: 22px;
    }

    #search-modal .predictive-search__icon,
    #search-modal .predictive-search__icon > svg {
      width: 20px;
      height: 20px;
    }

    #search-modal .predictive-search-form__content {
      height: 100%;
      max-height: none;
    }

    #search-modal .predictive-search-results__inner {
      padding: 20px var(--coszus-search-gutter) calc(30px + var(--safe-area-inset-bottom));
    }

    .coszus-search-idle {
      grid-template-columns: 1fr;
      gap: 26px;
    }

    .coszus-search-idle__shop-link {
      padding: 10px 0;
      font-size: 26px;
    }

    .coszus-search-idle__arrow {
      font-size: 18px;
      opacity: 1;
      transform: none;
    }

    /* Wrapped rows 8px apart so the pills' 44px hit areas don't overlap */
    .coszus-search-idle__terms {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 8px 6px;
    }

    .coszus-search-idle__terms a {
      position: relative;
      padding: 7px 13px;
      border: 1px solid var(--coszus-line);
      border-radius: 999px;
      font-size: 13px;
    }

    /* 44px hit area, centred on the pill */
    .coszus-search-idle__terms a::before {
      content: '';
      position: absolute;
      inset: min(0px, 50% - 22px) 0;
    }

    #search-modal .predictive-search-results__wrapper-products {
      display: flex;
      flex-direction: column;
      gap: 0;
    }

    #search-modal .predictive-search-results__card--product .resource-card {
      display: flex;
      flex-direction: row;
      align-items: center;
      gap: 12px;
      padding: 10px 0;
      border-bottom: 1px solid var(--coszus-search-line);
    }

    #search-modal .predictive-search-results__card--product .resource-card__media {
      flex: none;
      width: 56px;
      aspect-ratio: 3 / 4;
    }

    #search-modal .predictive-search-results__card--product .resource-card__content {
      flex: 1;
      padding: 0;
    }

    #search-modal .predictive-search-results__card--product .resource-card__image {
      aspect-ratio: 3 / 4;
    }

    #search-modal .predictive-search-results__card--product .resource-card__image--secondary {
      display: none;
    }

    #search-modal .predictive-search-results__card--product .resource-card {
      --resource-card-secondary-image-opacity: 0;
    }

    #search-modal .predictive-search-results__card .resource-card__title {
      font-size: 13px;
    }

    #search-modal .predictive-search-form__footer {
      padding-bottom: calc(18px + var(--safe-area-inset-bottom));
    }
  }
{% endstylesheet %}
