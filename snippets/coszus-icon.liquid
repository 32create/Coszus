{%- doc -%}
  Coszus line icons for the header, top bar, side menu, collection and product pages (1.5px stroke, currentColor).
  Decorative: the button or link around the icon carries the accessible name.

  @param {string} icon - search | wishlist | bag | account | menu | close | chevron | earn | spend | vip | refer | instagram | tiktok | globe | clearpay | filter | ruler | box | truck | returns
  @param {number} [px] - Width and height in px. Defaults to 21.

  @example
  {% render 'coszus-icon', icon: 'search', px: 19 %}
{%- enddoc -%}

{%- liquid
  assign px = px | default: 21
-%}

{%- case icon -%}
  {%- when 'search' -%}
    <svg class="coszus-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="{{ px }}" height="{{ px }}" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="10.5" cy="10.5" r="7"/><path d="M15.6 15.6L21 21"/></svg>
  {%- when 'wishlist' -%}
    <svg class="coszus-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="{{ px }}" height="{{ px }}" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5.5 3h13v18l-6.5-5-6.5 5z"/></svg>
  {%- when 'bag' -%}
    <svg class="coszus-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="{{ px }}" height="{{ px }}" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3.5" y="8" width="17" height="13"/><rect x="8.5" y="4" width="7" height="4"/></svg>
  {%- when 'account' -%}
    <svg class="coszus-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="{{ px }}" height="{{ px }}" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="8" r="4.2"/><path d="M3.5 21c.8-4.3 4.2-7 8.5-7s7.7 2.7 8.5 7"/></svg>
  {%- when 'menu' -%}
    <svg class="coszus-icon" aria-hidden="true" focusable="false" viewBox="0 0 17 10" width="17" height="10" fill="currentColor"><rect width="17" height="1.5"/><rect y="4.25" width="17" height="1.5"/><rect y="8.5" width="17" height="1.5"/></svg>
  {%- when 'close' -%}
    <svg class="coszus-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="{{ px }}" height="{{ px }}" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M5 5l14 14M19 5L5 19"/></svg>
  {%- when 'chevron' -%}
    <svg class="coszus-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="{{ px }}" height="{{ px }}" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 5l7 7-7 7"/></svg>
  {%- when 'earn' -%}
    <svg class="coszus-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="{{ px }}" height="{{ px }}" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 3v18M5 10l7-7 7 7"/></svg>
  {%- when 'spend' -%}
    <svg class="coszus-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="{{ px }}" height="{{ px }}" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 12v8H4v-8M2 7h20v5H2zM12 22V7M12 7S10 3 7.5 3 5 5.5 7 7M12 7s2-4 4.5-4S19 5.5 17 7"/></svg>
  {%- when 'vip' -%}
    <svg class="coszus-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="{{ px }}" height="{{ px }}" fill="currentColor"><path d="M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.9l-5.2 2.7 1-5.8-4.3-4.1 5.9-.9z"/></svg>
  {%- when 'refer' -%}
    <svg class="coszus-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="{{ px }}" height="{{ px }}" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20c.6-3.6 3.2-5.5 6.5-5.5s5.9 1.9 6.5 5.5"/><path d="M17 8v6M14 11h6"/></svg>
  {%- when 'instagram' -%}
    <svg class="coszus-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="{{ px }}" height="{{ px }}" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg>
  {%- when 'tiktok' -%}
    <svg class="coszus-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="{{ px }}" height="{{ px }}" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 3v11.5a3.5 3.5 0 1 1-3.5-3.5"/><path d="M14 3c.5 2.6 2.4 4.4 5 4.6"/></svg>
  {%- when 'globe' -%}
    <svg class="coszus-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="{{ px }}" height="{{ px }}" fill="none" stroke="currentColor" stroke-width="1.3"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3z"/></svg>
  {%- when 'clearpay' -%}
    <svg class="coszus-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="{{ px }}" height="{{ px }}" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 9.5l5-4 0 2.5h7"/><path d="M20 14.5l-5 4 0-2.5H8"/></svg>
  {%- when 'filter' -%}
    <svg class="coszus-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="{{ px }}" height="{{ px }}" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 6h16M7 12h10M10 18h4"/></svg>
  {%- when 'ruler' -%}
    <svg class="coszus-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="{{ px }}" height="{{ px }}" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2.5" y="8" width="19" height="8" rx="1"/><path d="M6 8v3M9.5 8v4.5M13 8v3M16.5 8v4.5"/></svg>
  {%- when 'box' -%}
    <svg class="coszus-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="{{ px }}" height="{{ px }}" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 3l8 4.5v9L12 21l-8-4.5v-9z"/><path d="M4 7.5l8 4.5 8-4.5M12 12v9"/></svg>
  {%- when 'truck' -%}
    <svg class="coszus-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="{{ px }}" height="{{ px }}" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2.5 6.5h11v9h-11zM13.5 9.5h4l3 3v3h-7z"/><circle cx="6.5" cy="17" r="1.6"/><circle cx="17" cy="17" r="1.6"/></svg>
  {%- when 'returns' -%}
    <svg class="coszus-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="{{ px }}" height="{{ px }}" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 7L4 12l5 5"/><path d="M4 12h11a5 5 0 0 1 0 10h-2"/></svg>
{%- endcase -%}
