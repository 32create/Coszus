{%- doc -%}
  Site-wide JSON-LD, rendered once from layout/theme.liquid (AUDIT S7):
  - Organization on every page: name, url, logo (Theme settings > Logo, else the header's default
    oval logo) and sameAs from Settings > Brand > Social links. Liquid in the layout can't read the
    header or footer section settings, so the social links come from the store's Brand settings.
  - BreadcrumbList on product and collection pages: Home > collection (when the product was opened
    from one) > product.
  The product node itself (with its images and rating) is output by
  snippets/coszus-product-structured-data.liquid, from sections/coszus-product.liquid.

  @example
  {%- render 'coszus-structured-data' -%}
{%- enddoc -%}

{%- liquid
  assign home_url = request.origin | append: routes.root_url

  # Liquid reads and/or right to left, so the page checks are spelled out
  assign breadcrumb_collection = false
  if collection and collection.url != blank
    assign breadcrumb_collection = true
  endif
  assign show_breadcrumbs = false
  if request.page_type == 'product' and product
    assign show_breadcrumbs = true
  elsif request.page_type == 'collection' and breadcrumb_collection
    assign show_breadcrumbs = true
  endif
  assign logo = settings.logo | default: shop.brand.logo
  if logo
    assign logo_url = logo | image_url: width: 600 | prepend: 'https:'
  else
    assign logo_url = 'coszus-logo.png' | asset_url | prepend: 'https:'
  endif

  assign same_as = ''
  assign social_keys = 'instagram,tiktok,facebook,youtube,twitter,pinterest,snapchat' | split: ','
  for key in social_keys
    assign social_url = shop.brand.metafields.social_links[key].value
    if social_url != blank
      assign same_as = same_as | append: '|' | append: social_url
    endif
  endfor
  assign same_as = same_as | remove_first: '|' | split: '|'
-%}

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": {{ shop.name | json }},
    "url": {{ shop.url | json }},
    "logo": {{ logo_url | json }}
    {%- if same_as.size > 0 -%}
      ,"sameAs": {{ same_as | json }}
    {%- endif %}
  }
</script>

{%- if show_breadcrumbs -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": {{ 'coszus.collection.home' | t | json }},
          "item": {{ home_url | json }}
        }
        {%- if breadcrumb_collection -%}
          ,{
            "@type": "ListItem",
            "position": 2,
            "name": {{ collection.title | json }},
            "item": {{ request.origin | append: collection.url | json }}
          }
        {%- endif -%}
        {%- if request.page_type == 'product' -%}
          ,{
            "@type": "ListItem",
            "position": {% if breadcrumb_collection %}3{% else %}2{% endif %},
            "name": {{ product.title | json }},
            "item": {{ request.origin | append: product.url | json }}
          }
        {%- endif %}
      ]
    }
  </script>
{%- endif -%}
