{%- doc -%}
  Black Friday on the sale pages (Theme settings > Black Friday > Sale collections), for
  sections/coszus-collection.liquid. Outside a Black Friday sale collection, or with the switch
  off, each part outputs nothing (or the label it was given), so the page is exactly as before.
  It lives here because coszus-collection.liquid is at theme check's Liquid complexity limit.

  Everything Black Friday is in the page whenever the switch is on and shown or hidden by
  <html data-bf="live"> (snippets/coszus-bf-state.liquid): data-bf-on parts show once it's live,
  data-bf-off parts hide.

  Parts:
  - eyebrow: the small "Black Friday · up to 70% off" line above Men / Women / Juniors in the hero
  - title: the bar title. "Sale" (or whatever it was) before, the sale name ("Black Friday") when live
  - note: the Rouge line under the title ("Spend £100, get a free tote or trek hat")
  - off: the data-bf-off attribute, for the normal category chips the Black Friday chips replace
  - chips: one chip per line of "Sale page chips" that this sale has products for, plus All.
    Each is the sale collection filtered to those product types (Search & Discovery's product
    type filter; several types in one chip show any of them). A line with = in it is a raw
    filter (e.g. filter.p.m.custom.tracksuit_piece=1) and shows only when that filter is on.
    Taps re-render the grid in place, like Clear filters (assets/coszus-collection.js).

  @param {string} part - eyebrow, title, note, off or chips
  @param {string} [label] - The normal bar title (title part)

  @example
  {% render 'coszus-bf-collection', part: 'title', label: bar_label %}
{%- enddoc -%}

{%- liquid
  assign bf_page = false
  if settings.bf_enabled or request.design_mode and settings.bf_editor_preview
    assign keys = 'bf_sale_men,bf_sale_women,bf_sale_juniors' | split: ','
    for key in keys
      if settings[key] != blank and settings[key].handle == collection.handle
        assign bf_page = true
        break
      endif
    endfor
    # Juniors Sale (handle juniors-sale) counts until a Juniors sale is picked in Theme settings
    if settings.bf_sale_juniors == blank and collection.handle == 'juniors-sale'
      assign bf_page = true
    endif
  endif
-%}

{%- if bf_page == false -%}
  {%- if part == 'title' -%}{{ label }}{%- endif -%}
{%- else -%}
  {%- case part -%}
    {%- when 'eyebrow' -%}
      {%- if settings.bf_tagline != blank -%}
        <p
          class="coszus-bf-eyebrow"
          data-bf-on
        >
          {{- settings.bf_tagline | escape -}}
        </p>
      {%- endif -%}

    {%- when 'title' -%}
      {%- if settings.bf_name != blank -%}
        <span data-bf-off>{{ label }}</span><span data-bf-on>{{ settings.bf_name | escape }}</span>
      {%- else -%}
        {{ label }}
      {%- endif -%}

    {%- when 'note' -%}
      {%- if settings.bf_offer != blank -%}
        <p
          class="coszus-bf-note"
          data-bf-on
        >
          {{- settings.bf_offer | escape -}}
        </p>
      {%- endif -%}

    {%- when 'off' -%}
      data-bf-off

    {%- when 'chips' -%}
      {%- liquid
        # What's applied now, as "|param=value|" pairs, to mark the chip that matches it
        assign current = '|'
        assign current_count = 0
        for filter in collection.filters
          for value in filter.active_values
            assign current = current | append: value.param_name | append: '=' | append: value.value | append: '|'
            assign current_count = current_count | plus: 1
          endfor
        endfor

        assign lines = settings.bf_chips | newline_to_br | split: '<br />'
      -%}
      <nav
        class="coszus-collection__tiles coszus-collection__tiles--pills coszus-bf-chips"
        aria-label="{{ 'coszus.collection.categories' | t }}"
        data-bf-on
        data-mc-swap="bf-chips"
      >
        <ul
          class="coszus-collection__tile-list"
          role="list"
        >
          <li>
            <a
              class="coszus-collection__tile{% if current_count == 0 %} is-active{% endif %}"
              href="{{ collection.url }}"
              data-mc-action="clear-and-apply"
              {% if current_count == 0 %}
                aria-current="page"
              {% endif %}
            >
              <span class="coszus-collection__tile-label">{{ 'coszus.collection.all' | t }}</span>
            </a>
          </li>
          {%- for raw_line in lines -%}
            {%- liquid
              # (a loop variable can't be reassigned in Liquid, so the trimmed copies get new names)
              assign line = raw_line | strip
              unless line contains ':'
                continue
              endunless
              assign chip_label = line | split: ':' | first | strip
              assign chip_values = line | remove_first: chip_label | remove_first: ':' | split: ','

              assign chip_query = ''
              assign chip_pairs = ''
              assign chip_count = 0
              assign chip_found = false
              for raw_value in chip_values
                assign chip_value = raw_value | strip
                if chip_value == blank
                  continue
                endif
                if chip_value contains '='
                  assign param = chip_value | split: '=' | first | strip
                  assign param_value = chip_value | remove_first: param | remove_first: '=' | strip
                  # True/false filters (like Tracksuit piece) come through as 1 or true: either matches,
                  # and the link uses the value Shopify gives the filter
                  assign wanted = param_value | split: '~~'
                  if param_value == '1' or param_value == 'true'
                    assign wanted = '1,true' | split: ','
                  endif
                  for filter in collection.filters
                    if filter.param_name == param
                      for filter_value in filter.values
                        if wanted contains filter_value.value
                          assign chip_found = true
                          assign param_value = filter_value.value
                        endif
                      endfor
                    endif
                  endfor
                else
                  assign param = 'filter.p.product_type'
                  assign param_value = chip_value
                  if collection.all_types contains chip_value
                    assign chip_found = true
                  endif
                endif
                assign escaped_value = param_value | url_param_escape
                assign chip_query = chip_query | append: '&' | append: param | append: '=' | append: escaped_value
                assign chip_pairs = chip_pairs | append: param | append: '=' | append: param_value | append: '|'
                assign chip_count = chip_count | plus: 1
              endfor

              if chip_label == blank or chip_found == false
                continue
              endif

              # Active when exactly this chip's filters are applied
              assign chip_active = true
              assign pairs = chip_pairs | split: '|'
              for pair in pairs
                assign needle = '|' | append: pair | append: '|'
                unless current contains needle
                  assign chip_active = false
                endunless
              endfor
              if current_count != chip_count
                assign chip_active = false
              endif

              assign chip_url = collection.url | append: '?' | append: chip_query | replace_first: '?&', '?'
            -%}
            <li>
              <a
                class="coszus-collection__tile{% if chip_active %} is-active{% endif %}"
                href="{{ chip_url }}"
                data-mc-action="clear-and-apply"
                {% if chip_active %}
                  aria-current="page"
                {% endif %}
              >
                <span class="coszus-collection__tile-label">{{ chip_label | escape }}</span>
              </a>
            </li>
          {%- endfor -%}
        </ul>
      </nav>
  {%- endcase -%}
{%- endif -%}

{% stylesheet %}
  /* Black Friday on the sale pages (snippets/coszus-bf-collection.liquid) */
  .coszus-bf-eyebrow {
    margin: 0 0 10px;
    font-size: var(--coszus-kicker-size, 0.6875rem);
    font-weight: 700;
    line-height: 1.4;
    letter-spacing: var(--coszus-kicker-tracking, 0.16em);
    text-transform: uppercase;
  }

  .coszus-bf-note {
    margin: -8px 0 0;
    color: var(--coszus-rouge, #c8102e);
    font-size: 14px;
    font-weight: 700;
    line-height: 1.3;
  }

  @media screen and (max-width: 820px) {
    .coszus-bf-note {
      margin-block-start: -4px;
      font-size: 13px;
    }
  }
{% endstylesheet %}
