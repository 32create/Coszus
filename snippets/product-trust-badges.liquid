{%- comment -%}
  Product trust badges
  Three static reassurance points with icons, shown in a row on the
  product page (wraps to a stack on narrow screens).

  Usage:
    {% render 'product-trust-badges' %}

  Or drop it into a "Custom liquid" block in the product section.
{%- endcomment -%}

<div class="trust-badges">
  <div class="trust-badge">
    <svg class="trust-badge__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M4 9h13l-3-3M20 15H7l3 3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
    <span class="trust-badge__text">Free Exchanges</span>
  </div>

  <div class="trust-badge">
    <svg class="trust-badge__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M20 12a8 8 0 1 1-2.34-5.66M20 4v3h-3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M12 8v4l2.5 1.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
    <span class="trust-badge__text">14 Day Returns</span>
  </div>

  <div class="trust-badge">
    <svg class="trust-badge__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M3 7h11v8H3zM14 10h4l3 3v2h-7z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
      <circle cx="7" cy="17" r="1.7" stroke="currentColor" stroke-width="1.6"/>
      <circle cx="17.5" cy="17" r="1.7" stroke="currentColor" stroke-width="1.6"/>
    </svg>
    <span class="trust-badge__text">Free shipping over &pound;80</span>
  </div>
</div>

<style>
  .trust-badges {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1.2rem 2rem;
    margin: 1.6rem 0;
  }
  .trust-badge {
    display: flex;
    align-items: center;
    gap: .7rem;
    font-size: 1.3rem;
    line-height: 1.3;
    color: rgb(var(--color-foreground, 18 18 18));
  }
  .trust-badge__icon {
    width: 22px;
    height: 22px;
    flex: 0 0 auto;
  }
  @media screen and (max-width: 749px) {
    .trust-badges {
      flex-direction: column;
      gap: 1rem;
    }
  }
</style>