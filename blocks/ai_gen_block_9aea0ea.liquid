{% doc %}
  @prompt
    Create a separate compact VAT text block for the very bottom of the website, below the existing footer content. Display exactly 'VAT REGISTRATION NUMBER: 525788845' in uppercase, centred on desktop and mobile. Inherit the website theme's font and match the footer's colours. Include adjustable spacing above and below the text, with a default of 32px above and 16px below, plus editable text and font size. Keep the design minimal and consistent with the existing footer., make the text bold
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-vat-line-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: {{ block.settings.space_above }}px auto {{ block.settings.space_below }}px;
    text-align: center;
    color: rgb(var(--color-foreground));
    font-family: var(--font-body-family);
    font-style: var(--font-body-style);
    font-weight: 700;
    font-size: {{ block.settings.font_size }}px;
    line-height: 1.4;
    overflow-wrap: anywhere;
  }
{% endstyle %}

<div class="ai-vat-line-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {{ block.settings.vat_text | escape | upcase }}
</div>

{% schema %}
{
  "name": "VAT registration text",
  "settings": [
    {
      "type": "text",
      "id": "vat_text",
      "label": "Text",
      "default": "VAT REGISTRATION NUMBER: 525788845"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font size",
      "min": 8,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "space_above",
      "label": "Space above",
      "min": 0,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "space_below",
      "label": "Space below",
      "min": 0,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "VAT registration text"
    }
  ],
  "tag": null,
  "class": "vat-registration-text"
}
{% endschema %}