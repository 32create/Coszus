{% doc %}
  @prompt
    divider
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-divider-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    margin: 0 auto;
  }

  .ai-divider-line-{{ ai_gen_id }} {
    border: none;
    height: {{ block.settings.thickness }}px;
    background-color: {{ block.settings.color }};
    opacity: {{ block.settings.opacity | divided_by: 100.0 }};
    margin: {{ block.settings.spacing_top }}px 0 {{ block.settings.spacing_bottom }}px 0;
  }

  .ai-divider-line-{{ ai_gen_id }}.ai-divider-style-dashed-{{ ai_gen_id }} {
    background: repeating-linear-gradient(
      to right,
      {{ block.settings.color }} 0,
      {{ block.settings.color }} {{ block.settings.dash_length }}px,
      transparent {{ block.settings.dash_length }}px,
      transparent {{ block.settings.dash_length | plus: block.settings.dash_gap }}px
    );
  }

  .ai-divider-line-{{ ai_gen_id }}.ai-divider-style-dotted-{{ ai_gen_id }} {
    background: repeating-linear-gradient(
      to right,
      {{ block.settings.color }} 0,
      {{ block.settings.color }} {{ block.settings.thickness }}px,
      transparent {{ block.settings.thickness }}px,
      transparent {{ block.settings.thickness | plus: block.settings.dot_gap }}px
    );
  }

  @media screen and (max-width: 749px) {
    .ai-divider-{{ ai_gen_id }} {
      width: 100%;
    }
  }
{% endstyle %}

<div class="ai-divider-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <hr class="ai-divider-line-{{ ai_gen_id }} ai-divider-style-{{ block.settings.style }}-{{ ai_gen_id }}">
</div>

{% schema %}
{
  "name": "Divider",
  "settings": [
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "options": [
        {
          "value": "solid",
          "label": "Solid"
        },
        {
          "value": "dashed",
          "label": "Dashed"
        },
        {
          "value": "dotted",
          "label": "Dotted"
        }
      ],
      "default": "solid"
    },
    {
      "type": "color",
      "id": "color",
      "label": "Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "thickness",
      "min": 1,
      "max": 10,
      "step": 1,
      "unit": "px",
      "label": "Thickness",
      "default": 1
    },
    {
      "type": "range",
      "id": "opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Opacity",
      "default": 15
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "Dashed style"
    },
    {
      "type": "range",
      "id": "dash_length",
      "min": 4,
      "max": 20,
      "step": 2,
      "unit": "px",
      "label": "Dash length",
      "default": 10
    },
    {
      "type": "range",
      "id": "dash_gap",
      "min": 2,
      "max": 20,
      "step": 2,
      "unit": "px",
      "label": "Dash gap",
      "default": 6
    },
    {
      "type": "header",
      "content": "Dotted style"
    },
    {
      "type": "range",
      "id": "dot_gap",
      "min": 2,
      "max": 20,
      "step": 2,
      "unit": "px",
      "label": "Dot gap",
      "default": 6
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "spacing_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top spacing",
      "default": 40
    },
    {
      "type": "range",
      "id": "spacing_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom spacing",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Divider"
    }
  ]
}
{% endschema %}
